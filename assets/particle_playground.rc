// Windows resource script — embedded icon + version info for .exe
#include <winver.h>

// Application icon (used by Windows Explorer, taskbar, etc.)
1 ICON "assets/icon_256.ico"

// Version information resource
VS_VERSION_INFO VERSIONINFO
FILEVERSION    0,1,0,0
PRODUCTVERSION 0,1,0,0
FILEFLAGSMASK  VS_FFI_FILEFLAGSMASK
FILEFLAGS      0
FILEOS         VOS_NT_WINDOWS32
FILETYPE       VFT_APP
FILESUBTYPE    VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName",      "\0"
            VALUE "FileDescription",  "Particle Playground - Quantum Physics Sandbox\0"
            VALUE "FileVersion",      "0.1.0\0"
            VALUE "InternalName",     "particle_physics\0"
            VALUE "OriginalFilename", "particle_physics.exe\0"
            VALUE "ProductName",      "Particle Playground\0"
            VALUE "ProductVersion",   "0.1.0\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 0x04B0
    END
END
