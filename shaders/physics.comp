// ── Physics constants ───────────────────────────────────────────────────────
// Force hierarchy: Strong > EM > Weak > Gravity (at nuclear distances)
// Yukawa must dominate Coulomb at dist 4-8px for nuclei to form
const float YUKAWA_RANGE     = 8.0;
const float YUKAWA_COUPLING  = 2000.0;  // ~10x Coulomb at nuclear distances
const float PAULI_CORE       = 6.0;     // nucleon hard-core radius (smooth overlap)
const float PAULI_STRENGTH   = 12000.0; // must dominate Yukawa at close range
const float K_COULOMB        = 1200.0;  // electromagnetic strength
const float SOFTEN_MIN       = 2.0;     // softening distance for Coulomb (numerical only)
const float L_MIN              = 120.0;  // minimum angular momentum (ground state orbital)
const float K_SPIN_ORBIT       = 0.3;   // spin-orbit coupling strength (fine structure)
const float CENTRIFUGAL_SOFTEN = 1.0;   // softening for r→0 stability
const float K_MAGNETIC         = 1.0;   // intrinsic Biot-Savart coupling (scaled for 1/r²)
const float MU_PROTON_ANOM   = 2.793;  // proton magnetic moment (nuclear magnetons, g ≈ 5.586)
const float MU_NEUTRON       = -1.913; // neutron magnetic moment (anomalous — nonzero despite q=0)
const float K_DIPOLE         = 1.0;    // dipole B-field coupling (1/r³ falloff) — mu_intrinsic is full moment
const float ANNIHIL_RADIUS   = 6.0;
const float ANNIHIL_ATTRACTION = 200.0;
const float ANNIHIL_DRAIN    = 0.4;
const float PHOTON_DRAIN     = 0.07;
const float NEUTRINO_DRAIN   = 0.02;
const float COLOR_ALPHA_S    = 400.0;   // QCD short-range coupling

// ── Relativistic constants ──────────────────────────────────────────────────
const float C_SIM       = 300.0;   // speed of light in sim units (px/frame)
const float C_SIM_SQ    = 90000.0; // c²

// ── Genome accessors ────────────────────────────────────────────────────────
float get_charge(uint i) { return genome_buffer.data[i * 4u + 0u]; }
float get_spin(uint i)   { return genome_buffer.data[i * 4u + 1u]; }
float get_color(uint i)  { return genome_buffer.data[i * 4u + 2u]; }
float get_decay(uint i)  { return genome_buffer.data[i * 4u + 3u]; }

// ── Helpers ─────────────────────────────────────────────────────────────────
bool is_baryon(uint t) {
    return t <= NEUTRON_TYPE || t == ANTIPROTON_TYPE;
}

bool is_quark_type(uint flags) {
    return (flags & BEHAVIOR_QUARK) != 0u;
}

bool is_colored(uint flags) {
    return (flags & (BEHAVIOR_QUARK | BEHAVIOR_GLUON_FLAG)) != 0u;
}

bool is_annihilation_pair(uint a, uint b) {
    return (a == ELECTRON_TYPE && b == POSITRON_TYPE)
        || (a == POSITRON_TYPE && b == ELECTRON_TYPE)
        || (a == PROTON_TYPE   && b == ANTIPROTON_TYPE)
        || (a == ANTIPROTON_TYPE && b == PROTON_TYPE)
        || (a == MUON_TYPE     && b == ANTIMUON_TYPE)
        || (a == ANTIMUON_TYPE && b == MUON_TYPE)
        || (a == TAU_TYPE      && b == ANTITAU_TYPE)
        || (a == ANTITAU_TYPE  && b == TAU_TYPE)
        // Quark-antiquark annihilation (same flavor only)
        || (a >= UP_QUARK && a <= BOTTOM_QUARK && b == a + 6u)
        || (a >= ANTI_UP && a <= ANTI_BOTTOM && b == a - 6u);
}

// Per-type inverse mass — CPU-populated lookup table (binding 18)
float get_mass_inv(uint type) {
    return mass_zpe_buffer.data[type * 2u];
}

// Get mass (inverse of get_mass_inv, clamped)
float get_mass(uint type) {
    float inv = get_mass_inv(type);
    return (inv > 0.001) ? 1.0 / inv : 1000.0;
}

// Zero-point energy floor per particle type — CPU-populated lookup table (binding 18)
float get_zpe(uint type) {
    return mass_zpe_buffer.data[type * 2u + 1u];
}

// Color interaction factor between two colored particles (quark-quark)
float color_factor(float ca, float cb) {
    // Quark-antiquark: same abs color → strong attraction (meson)
    if (ca * cb < 0.0 && abs(abs(ca) - abs(cb)) < 0.1) return -1.0;
    // Same color same sign → repulsion
    if (abs(ca - cb) < 0.1) return 0.5;
    // Different colors, same sign → weak attraction (baryon formation, RGB → white)
    if (ca > 0.0 && cb > 0.0) return -0.3;
    if (ca < 0.0 && cb < 0.0) return -0.3;
    return 0.0;
}

// ── Gluon bi-color extractors ──────────────────────────────────────────────
// Gluon color encoded as X.Y: X = carried color, Y/10 = anticolor index
float gluon_carried(float c)  { return floor(abs(c)); }            // 1=R, 2=G, 3=B
float gluon_anticolor(float c){ return round(fract(abs(c))*10.0); }// 1=R̄, 2=Ḡ, 3=B̄

// Enhanced color factor that handles gluon color-anticolor pairs
float color_factor_gluon(float ca, float cb, uint flags_a, uint flags_b) {
    bool ga = (flags_a & BEHAVIOR_GLUON_FLAG) != 0u;
    bool gb = (flags_b & BEHAVIOR_GLUON_FLAG) != 0u;

    // ── Gluon-gluon: SU(3) non-Abelian self-coupling ──────────────────
    if (ga && gb) {
        float ac_a = gluon_carried(ca);
        float aac_a = gluon_anticolor(ca);
        float ac_b = gluon_carried(cb);
        float aac_b = gluon_anticolor(cb);
        // Trilinear vertex: anticolor of A matches color of B (or vice versa)
        if (abs(aac_a - ac_b) < 0.1 || abs(aac_b - ac_a) < 0.1)
            return -1.5;  // strong attraction — vertex allowed
        // Identical state: boson repulsion
        if (abs(ac_a - ac_b) < 0.1 && abs(aac_a - aac_b) < 0.1)
            return 0.8;   // repulsion
        return -0.2;      // weak residual attraction
    }

    // ── Gluon-quark: absorption/emission vertices ──────────────────────
    if (ga || gb) {
        float gc = ga ? ca : cb;  // gluon's color
        float qc = ga ? cb : ca;  // quark's color
        float g_carried = gluon_carried(gc);
        float g_anti    = gluon_anticolor(gc);
        float q_abs     = abs(qc);
        // Absorption vertex: gluon anticolor matches quark color
        if (abs(g_anti - q_abs) < 0.1) return -1.2;
        // Emission vertex: gluon carried color matches quark color
        if (abs(g_carried - q_abs) < 0.1) return -0.8;
        return -0.1;  // weak residual
    }

    // ── Quark-quark: original logic ────────────────────────────────────
    return color_factor(ca, cb);
}

// ═══════════════════════════════════════════════════════════════════════════════
//  PHYSICS STEP
// ═══════════════════════════════════════════════════════════════════════════════

void apply_physics(uint i) {
    vec2  pos_a   = in_pos_buffer.data[i];
    vec2  vel_a   = in_vel_buffer.data[i];
    uint  type_a  = type_buffer.data[i];
    uint  flags_a = behavior_buffer.data[type_a];
    float energy  = in_energy_buffer.data[i];

    // ── Dormant fast-path ────────────────────────────────────────────────────
    if (energy < 0.001) {
        out_pos_buffer.data[i]    = pos_a;
        out_vel_buffer.data[i]    = vec2(0.0);
        out_energy_buffer.data[i] = 0.0;
        angle_out_buffer.data[i]  = angle_in_buffer.data[i];
        avel_out_buffer.data[i]   = avel_in_buffer.data[i];
        return;
    }

    // ── Photon fast-path ─────────────────────────────────────────────────────
    if ((flags_a & BEHAVIOR_PHOTON) != 0u) {
        // Tachyon: superluminal, high energy drain, enforce speed > 1.33c
        if (type_a == TACHYON_TYPE) {
            float tach_energy = max(energy - 0.3 * params.dt, 0.0);
            vec2 tach_vel = vel_a;
            float tach_spd = length(tach_vel);
            float min_speed = C_SIM * 1.33;
            if (tach_spd < min_speed) {
                tach_vel = (tach_spd > 0.1) ? normalize(tach_vel) * min_speed
                         : vec2(min_speed, 0.0);
            }
            out_energy_buffer.data[i] = tach_energy;
            out_pos_buffer.data[i]    = pos_a + tach_vel * params.dt;
            out_vel_buffer.data[i]    = tach_vel;
            angle_out_buffer.data[i]  = angle_in_buffer.data[i];
            avel_out_buffer.data[i]   = avel_in_buffer.data[i];
            return;
        }
        float ph_energy = max(energy - PHOTON_DRAIN * params.dt, 0.0);
        vec2  ph_vel = vel_a;

        // High-energy photon Compton recoil: scan for nearest charged matter
        // and deflect slightly + lose energy on close approach
        if (ph_energy > 0.2) {
            float closest_ch_dist = 9999.0;
            vec2  closest_ch_pos  = vec2(0.0);
            float closest_ch_charge = 0.0;

            // Grid-based scan for nearest charged matter (30px radius)
            int ph_cx = clamp(int(pos_a.x / GRID_CELL_SIZE), 0, GRID_COLS - 1);
            int ph_cy = clamp(int(pos_a.y / GRID_CELL_SIZE), 0, GRID_ROWS - 1);
            for (int gy = max(0, ph_cy - 1); gy <= min(GRID_ROWS - 1, ph_cy + 1); gy++) {
            for (int gx = max(0, ph_cx - 1); gx <= min(GRID_COLS - 1, ph_cx + 1); gx++) {
                uint gc = uint(gy * GRID_COLS + gx);
                for (uint gk = grid_cell_start.data[gc]; gk < grid_cell_start.data[gc + 1u]; gk++) {
                uint j = grid_indices.data[gk];
                if (j == i) continue;
                float e_j = in_energy_buffer.data[j];
                if (e_j < 0.001) continue;

                vec2  p_j = in_pos_buffer.data[j];
                vec2  d   = p_j - pos_a;
                float d2  = dot(d, d);
                if (d2 > 900.0 || d2 <= 0.0) continue;  // 30px radius

                float q_j = genome_buffer.data[j * 4u + 0u];
                if (abs(q_j) < 0.01) continue;  // only charged particles

                float dd = sqrt(d2);
                if (dd < closest_ch_dist) {
                    closest_ch_dist = dd;
                    closest_ch_pos  = p_j;
                    closest_ch_charge = q_j;
                }
            } } }

            // Compton recoil: deflect photon and transfer energy
            if (closest_ch_dist < 30.0) {
                vec2 to_matter = normalize(closest_ch_pos - pos_a);
                // Deflection angle scales with 1/r and photon energy
                float deflect = 0.15 * ph_energy / (closest_ch_dist + 2.0);
                // Rotate velocity slightly toward the charged particle
                ph_vel += to_matter * deflect * length(ph_vel);
                ph_vel = normalize(ph_vel) * C_SIM;  // enforce speed of light
                // Energy transfer: photon loses energy proportional to proximity
                float e_loss = ph_energy * 0.02 / (closest_ch_dist * 0.1 + 1.0);
                ph_energy = max(ph_energy - e_loss, 0.0);
            }
        }

        out_energy_buffer.data[i] = ph_energy;
        out_pos_buffer.data[i]    = pos_a + ph_vel * params.dt;
        out_vel_buffer.data[i]    = ph_vel;
        angle_out_buffer.data[i]  = angle_in_buffer.data[i];
        avel_out_buffer.data[i]   = avel_in_buffer.data[i];
        return;
    }

    // ── Gluon QCD fast-path ──────────────────────────────────────────────────
    // Gluons are massless colored bosons: travel at c, deflected by color forces.
    // Non-Abelian: self-interact via SU(3) trilinear vertex (g+g→g coupling).
    // Uses strided scan to find colored neighbors (quarks + other gluons).
    if ((flags_a & BEHAVIOR_GLUON_FLAG) != 0u) {
        float glu_energy = max(energy - PHOTON_DRAIN * 1.5 * params.dt, 0.0);
        vec2  glu_vel = vel_a;
        float glu_speed = length(glu_vel);

        // Effective mass from energy: m_eff = E/c² (relativistic inertia)
        // Higher-energy gluons resist deflection (asymptotic freedom)
        float glu_eff_mass = max(glu_energy / C_SIM_SQ, 0.0001);
        float glu_color = get_color(i);

        // Accumulated QCD color force from nearby colored particles
        vec2  color_force = vec2(0.0);
        float interaction_e = 0.0;

        if (glu_energy > 0.05) {
            // Grid-based scan for colored neighbors (60px QCD confinement range)
            int glu_cx = clamp(int(pos_a.x / GRID_CELL_SIZE), 0, GRID_COLS - 1);
            int glu_cy = clamp(int(pos_a.y / GRID_CELL_SIZE), 0, GRID_ROWS - 1);
            for (int gy = max(0, glu_cy - 1); gy <= min(GRID_ROWS - 1, glu_cy + 1); gy++) {
            for (int gx = max(0, glu_cx - 1); gx <= min(GRID_COLS - 1, glu_cx + 1); gx++) {
                uint gc = uint(gy * GRID_COLS + gx);
                for (uint gk = grid_cell_start.data[gc]; gk < grid_cell_start.data[gc + 1u]; gk++) {
                uint j = grid_indices.data[gk];
                if (j == i) continue;
                float e_j = in_energy_buffer.data[j];
                if (e_j < 0.001) continue;

                uint type_j  = type_buffer.data[j];
                uint flags_j = behavior_buffer.data[type_j];
                if (!is_colored(flags_j)) continue;

                vec2  p_j = in_pos_buffer.data[j];
                vec2  d   = p_j - pos_a;
                float d2  = dot(d, d);
                if (d2 > 3600.0 || d2 <= 0.0) continue;  // 60px radius

                float dist   = sqrt(d2);
                vec2  normal = d / dist;
                float color_j = get_color(j);

                float cf = color_factor_gluon(glu_color, color_j, flags_a, flags_j);
                if (abs(cf) < 0.01) continue;

                float inv_r = 1.0 / max(dist, 0.5);

                // Cornell potential: color-Coulomb + linear confinement
                // Running coupling: asymptotic freedom at short distance
                float alpha_eff = params.alpha_s_scale * COLOR_ALPHA_S
                    * max(0.3, 1.0 + 0.3 * log(max(dist, 0.5)));
                float short_range = alpha_eff * inv_r * inv_r;
                float confine = params.string_tension * 0.1;

                // Casimir enhancement for gluon-gluon pairs: C_A/C_F ≈ 2.25
                bool both_gluons = (flags_j & BEHAVIOR_GLUON_FLAG) != 0u;
                float casimir = both_gluons ? 2.25 : 1.0;

                float cornell_F = cf * casimir * (-short_range - confine);
                color_force += normal * cornell_F;

                // Hard-core repulsion at very close range
                if (dist < 2.0) {
                    float core = 400.0 / (dist * dist + 0.1);
                    color_force -= normal * core;
                }

                // Binding energy for close color interactions
                if (dist < 15.0 && cf < 0.0) {
                    interaction_e += 0.004 * params.dt;
                }

                // String tension energy drain when far from colored partners
                if (cf < -0.5 && dist > 40.0) {
                    interaction_e -= 0.2 * params.dt;
                }
            } } }
        }

        // Apply color force as momentum deflection (massless kinematics)
        // Momentum p = E/c for massless, direction from velocity
        if (glu_speed > 0.1 && dot(color_force, color_force) > 0.0001) {
            vec2 momentum = normalize(glu_vel) * glu_energy / C_SIM;
            momentum += color_force * params.dt * 0.01 / glu_eff_mass;
            glu_vel = normalize(momentum) * C_SIM;
        } else if (glu_speed < 0.1) {
            // Stationary gluon: random kick at c
            uint seed = (i * 1664525u + params.step * 1013904223u) ^ 0x9e3779b9u;
            seed ^= (seed >> 17u); seed *= 0xbf58476du; seed ^= (seed >> 31u);
            float angle = float(seed) * (6.28318 / 4294967296.0);
            glu_vel = vec2(cos(angle), sin(angle)) * C_SIM;
        }

        glu_energy = clamp(glu_energy + interaction_e, 0.0, 1.0);

        out_energy_buffer.data[i] = glu_energy;
        out_pos_buffer.data[i]    = pos_a + glu_vel * params.dt;
        out_vel_buffer.data[i]    = glu_vel;
        angle_out_buffer.data[i]  = angle_in_buffer.data[i];
        avel_out_buffer.data[i]   = avel_in_buffer.data[i];
        return;
    }

    // ── Neutrino fast-path (ballistic + Z-coupling deflection) ─────────────
    if ((flags_a & BEHAVIOR_NEUTRINO) != 0u) {
        float nu_energy = max(energy - NEUTRINO_DRAIN * params.dt, 0.0);
        vec2 nu_vel = vel_a;

        // Grid-based scan for nearby Z bosons (10px range)
        int nu_cx = clamp(int(pos_a.x / GRID_CELL_SIZE), 0, GRID_COLS - 1);
        int nu_cy = clamp(int(pos_a.y / GRID_CELL_SIZE), 0, GRID_ROWS - 1);
        for (int gy = max(0, nu_cy - 1); gy <= min(GRID_ROWS - 1, nu_cy + 1); gy++) {
        for (int gx = max(0, nu_cx - 1); gx <= min(GRID_COLS - 1, nu_cx + 1); gx++) {
            uint gc = uint(gy * GRID_COLS + gx);
            for (uint gk = grid_cell_start.data[gc]; gk < grid_cell_start.data[gc + 1u]; gk++) {
            uint j = grid_indices.data[gk];
            if (j == i) continue;
            uint type_j = type_buffer.data[j];
            if (type_j != Z_BOSON_TYPE) continue;
            vec2 delta = in_pos_buffer.data[j] - pos_a;
            float d2 = dot(delta, delta);
            if (d2 > 100.0 || d2 < 0.01) continue; // 10px range
            float dist = sqrt(d2);
            vec2 n = delta / dist;
            // Weak NC deflection from Z boson
            nu_vel += n * params.weak_coupling * 150.0 * exp(-dist / 1.5) * params.dt * 0.001;
        } } }

        // Preserve speed (massless)
        float nu_speed = length(nu_vel);
        if (nu_speed > 0.001) nu_vel = nu_vel * (length(vel_a) / nu_speed);

        out_energy_buffer.data[i] = nu_energy;
        out_pos_buffer.data[i]    = pos_a + nu_vel * params.dt;
        out_vel_buffer.data[i]    = nu_vel;
        angle_out_buffer.data[i]  = angle_in_buffer.data[i];
        avel_out_buffer.data[i]   = avel_in_buffer.data[i];
        return;
    }

    // ── W/Z boson fast-path (mini force loop: Coulomb, triple/quartic gauge) ──
    if ((flags_a & BEHAVIOR_WEAK_BOSON) != 0u) {
        float boson_energy = max(energy - 0.5 * params.dt, 0.0);
        vec2 wb_force = vec2(0.0);
        float q_a = get_charge(i); // W+: +1, W-: -1, Z: 0
        uint wb_count = 0u;

        // Grid-based scan (100px range)
        int wb_cx = clamp(int(pos_a.x / GRID_CELL_SIZE), 0, GRID_COLS - 1);
        int wb_cy = clamp(int(pos_a.y / GRID_CELL_SIZE), 0, GRID_ROWS - 1);
        for (int gy = max(0, wb_cy - 1); gy <= min(GRID_ROWS - 1, wb_cy + 1); gy++) {
        for (int gx = max(0, wb_cx - 1); gx <= min(GRID_COLS - 1, wb_cx + 1); gx++) {
            uint gc = uint(gy * GRID_COLS + gx);
            for (uint gk = grid_cell_start.data[gc]; gk < grid_cell_start.data[gc + 1u]; gk++) {
            uint j = grid_indices.data[gk];
            if (j == i) continue;
            vec2 delta = in_pos_buffer.data[j] - pos_a;
            float d2 = dot(delta, delta);
            if (d2 > 10000.0 || d2 < 0.01) continue; // 100px range
            float dist = sqrt(d2);
            vec2 n = delta / dist;
            uint type_j = type_buffer.data[j];
            uint flags_j = behavior_buffer.data[type_j];
            float q_b = genome_buffer.data[j * 4u + 0u];

            // 1. Coulomb: W± feel/exert EM (Z has charge 0, skips naturally)
            if (abs(q_a) > 0.01 && abs(q_b) > 0.01) {
                float coul_F = params.coulomb_strength * K_COULOMB * q_a * q_b / (d2 + 4.0);
                wb_force += n * coul_F;
            }

            // 2. WWγ triple gauge: radiation pressure from photons on charged W±
            if ((flags_j & BEHAVIOR_PHOTON) != 0u && abs(q_a) > 0.01 && dist < 30.0) {
                float ph_E = in_energy_buffer.data[j];
                wb_force += n * ph_E * 50.0 * exp(-dist / 10.0) / max(d2, 1.0);
            }

            // 3. WWZ triple gauge: W-W attraction via Z exchange
            if ((flags_j & BEHAVIOR_WEAK_BOSON) != 0u) {
                float q_j_wb = genome_buffer.data[j * 4u + 0u];
                // W+W- attract, same-sign repel, Z mediates
                float sign_prod = (abs(q_a) > 0.01 && abs(q_j_wb) > 0.01) ? q_a * q_j_wb : 0.0;
                float gauge_F = params.weak_coupling * 200.0 * sign_prod * exp(-dist / 4.0) / max(d2, 0.1);
                wb_force += n * gauge_F;

                // 4. Quartic gauge: density enhancement when multiple WBs close
                if (dist < 8.0) wb_count++;
            }
        } } }

        // Quartic gauge density enhancement
        float quartic_scale = 1.0 + 0.3 * float(wb_count);
        wb_force *= quartic_scale;

        vec2 wb_vel = vel_a * 0.95 + wb_force * params.dt * 0.5 * get_mass_inv(type_a);
        out_energy_buffer.data[i] = boson_energy;
        out_pos_buffer.data[i]    = pos_a + wb_vel * params.dt * 0.5;
        out_vel_buffer.data[i]    = wb_vel;
        angle_out_buffer.data[i]  = angle_in_buffer.data[i];
        avel_out_buffer.data[i]   = avel_in_buffer.data[i];
        return;
    }

    // ── Higgs fast-path (mini force loop: Yukawa coupling, self-coupling, W/Z coupling) ──
    if ((flags_a & BEHAVIOR_HIGGS_FLAG) != 0u) {
        float h_energy = max(energy - 0.4 * params.dt, 0.0);
        vec2 h_force = vec2(0.0);
        float vev = max(params.higgs_vev, 1.0);

        // Grid-based scan (50px range)
        int h_cx = clamp(int(pos_a.x / GRID_CELL_SIZE), 0, GRID_COLS - 1);
        int h_cy = clamp(int(pos_a.y / GRID_CELL_SIZE), 0, GRID_ROWS - 1);
        for (int gy = max(0, h_cy - 1); gy <= min(GRID_ROWS - 1, h_cy + 1); gy++) {
        for (int gx = max(0, h_cx - 1); gx <= min(GRID_COLS - 1, h_cx + 1); gx++) {
            uint gc = uint(gy * GRID_COLS + gx);
            for (uint gk = grid_cell_start.data[gc]; gk < grid_cell_start.data[gc + 1u]; gk++) {
            uint j = grid_indices.data[gk];
            if (j == i) continue;
            vec2 delta = in_pos_buffer.data[j] - pos_a;
            float d2 = dot(delta, delta);
            if (d2 > 2500.0 || d2 < 0.01) continue; // 50px range
            float dist = sqrt(d2);
            vec2 n = delta / dist;
            uint type_j = type_buffer.data[j];
            uint flags_j = behavior_buffer.data[type_j];
            float mass_j = get_mass(type_j);

            // 1. Yukawa coupling to fermions: F ∝ (m_j / vev) × exp(-r/5)
            float F = (mass_j / vev) * 300.0 * exp(-dist / 5.0) / max(dist, 0.5);

            // 2. Higgs self-coupling (λ=0.13)
            if ((flags_j & BEHAVIOR_HIGGS_FLAG) != 0u) {
                F += 0.13 * 100.0 * exp(-dist / 8.0) / max(dist, 0.5);
            }

            // 3. W/Z coupling (gauge boson mass generation)
            if ((flags_j & BEHAVIOR_WEAK_BOSON) != 0u) {
                F += (mass_j / vev) * 500.0 * exp(-dist / 6.0) / max(dist, 0.5);
            }

            h_force += n * F;
        } } }

        vec2 h_vel = vel_a * 0.9 + h_force * params.dt * 0.1 * get_mass_inv(type_a);
        out_energy_buffer.data[i] = h_energy;
        out_pos_buffer.data[i]    = pos_a + h_vel * params.dt * 0.1;
        out_vel_buffer.data[i]    = h_vel;
        angle_out_buffer.data[i]  = angle_in_buffer.data[i];
        avel_out_buffer.data[i]   = avel_in_buffer.data[i];
        return;
    }

    // ── Full pairwise physics ────────────────────────────────────────────────
    float mass_inv_a = get_mass_inv(type_a);
    float charge_a   = get_charge(i);
    float spin_a     = get_spin(i);
    float color_a    = get_color(i);

    vec2  total_force = vec2(0.0);
    float interaction_energy = 0.0;
    float local_density = 0.0;

    // Centrifugal barrier tracking (electrons only) — applied ONCE after loop
    bool  is_light_particle = (flags_a & BEHAVIOR_LEPTON) != 0u && abs(charge_a) > 0.01;  // all charged leptons (e/mu/tau)
    float closest_nuc_dist  = 9999.0;
    vec2  closest_nuc_delta = vec2(0.0);
    vec2  closest_nuc_vel   = vec2(0.0);
    float nearby_charge_sum = 0.0;  // sum of nearby charges (for magnetic moment gating)
    float accumulated_Bz    = 0.0;  // total B-field from all neighbors (for spin coupling)

    // Hard-sphere collision accumulation — corrected after integration
    bool  is_massive_a    = mass_inv_a < 10.0;
    vec2  collision_push   = vec2(0.0);       // accumulated position correction from ALL overlaps
    float max_vn           = 0.0;             // max inward normal velocity (for elastic response)
    vec2  max_vn_normal    = vec2(0.0);       // normal of strongest collision
    float max_vn_mass_b    = 1.0;             // mass of strongest collision partner

    float MAX_RADIUS    = params.interaction_radius;
    float MAX_RADIUS_SQ = MAX_RADIUS * MAX_RADIUS;

    // ── Pre-loop cached values (avoid per-pair recalculation) ──────────
    float mass                 = 1.0 / max(mass_inv_a, 0.00001);
    float inv_repulsion_radius = 1.0 / max(params.repulsion_radius, 0.001);
    float inv_yukawa_range     = 1.0 / YUKAWA_RANGE;
    float inv_c_sim            = 1.0 / C_SIM;

    // ── Grid-based neighbor iteration (replaces O(N²) brute force) ────────
    int cell_x = clamp(int(pos_a.x / GRID_CELL_SIZE), 0, GRID_COLS - 1);
    int cell_y = clamp(int(pos_a.y / GRID_CELL_SIZE), 0, GRID_ROWS - 1);
    int search_r = int(ceil(MAX_RADIUS / GRID_CELL_SIZE));
    for (int cy = max(0, cell_y - search_r); cy <= min(GRID_ROWS - 1, cell_y + search_r); cy++) {
    for (int cx = max(0, cell_x - search_r); cx <= min(GRID_COLS - 1, cell_x + search_r); cx++) {
        uint g_cell  = uint(cy * GRID_COLS + cx);
        uint g_start = grid_cell_start.data[g_cell];
        uint g_end   = grid_cell_start.data[g_cell + 1u];
        for (uint g_k = g_start; g_k < g_end; g_k++) {
        int j = int(grid_indices.data[g_k]);
        if (i == uint(j)) continue;

        float energy_b = in_energy_buffer.data[j];
        if (energy_b < 0.001) continue;

        vec2  pos_b   = in_pos_buffer.data[j];
        vec2  delta   = pos_b - pos_a;
        float dist_sq = dot(delta, delta);

        if (dist_sq <= 0.0 || dist_sq >= MAX_RADIUS_SQ) continue;

        float dist   = sqrt(dist_sq);
        vec2  normal = delta / dist;
        uint  type_b = type_buffer.data[j];
        uint  flags_b = behavior_buffer.data[type_b];

        // Skip non-interacting particles (neutrinos, W/Z bosons, Higgs)
        if ((flags_b & (BEHAVIOR_NEUTRINO | BEHAVIOR_WEAK_BOSON | BEHAVIOR_HIGGS_FLAG)) != 0u) continue;

        // ── Photon-matter interaction (Compton scattering + EM field) ───────
        if ((flags_b & BEHAVIOR_PHOTON) != 0u) {
            float ph_energy = in_energy_buffer.data[j];
            // High-energy photons interact with charged matter
            if (ph_energy > 0.2 && abs(charge_a) > 0.01 && dist < 40.0) {
                vec2  ph_vel = in_vel_buffer.data[j];
                float ph_speed = length(ph_vel);
                if (ph_speed > 0.1) {
                    vec2 ph_dir = ph_vel / ph_speed;

                    // Compton radiation pressure: photon pushes matter along its travel direction
                    // Scales with photon energy and 1/r² (short range dominant)
                    float compton_F = params.compton_strength * ph_energy * 30.0 / (dist_sq + 4.0);
                    total_force += ph_dir * compton_F;

                    // Photon's oscillating B-field (z-component, falls as 1/r²)
                    // Lorentz force: F = q * (v × B) — in 2D, F = q*Bz*(vy,-vx)
                    float ph_Bz = ph_energy * 15.0 / (dist_sq + 4.0);
                    total_force += charge_a * ph_Bz * vec2(vel_a.y, -vel_a.x);
                }
            }
            continue;  // photons don't participate in other force calculations
        }

        // Dark matter: only gravity + self-interaction, skip all EM/strong/weak
        bool dm_a = (flags_a & BEHAVIOR_DARK_MATTER) != 0u;
        bool dm_b = (flags_b & BEHAVIOR_DARK_MATTER) != 0u;
        bool dm_interaction = dm_a || dm_b;

        // ── Dark energy: cosmological-constant-like universal repulsion ────────
        // Lambda-CDM: effective repulsive acceleration a = (Λ/3)·r, so F = m·(Λ/3)·r
        // Force grows linearly with distance (opposite of gravity).
        // Dark energy does NOT interact via EM, strong, or weak forces.
        bool de_a = (flags_a & BEHAVIOR_DARK_ENERGY) != 0u;
        bool de_b = (flags_b & BEHAVIOR_DARK_ENERGY) != 0u;
        if (de_a || de_b) {
            // Base cosmological constant: F = Λ_eff · m · r
            float lambda_eff = 0.8 / (MAX_RADIUS + 1.0);
            float de_force = lambda_eff * mass * dist;

            // Inflaton: drives exponential inflation (much stronger than late-time DE)
            // de Sitter expansion: a ∝ H²·r with H_inflation >> H_0
            if (type_a == INFLATON_TYPE || type_b == INFLATON_TYPE) {
                de_force *= 20.0;  // inflationary era ~10^50× stronger; capped for sim
            }

            // Chameleon scalar field: environment-dependent screening
            // In dense matter (short-range pairs), the chameleon mass increases
            // and the force is exponentially suppressed (thin-shell effect).
            // In vacuum (long-range pairs), full DE repulsion applies.
            if (type_a == CHAMELEON_TYPE || type_b == CHAMELEON_TYPE) {
                // Screening factor: suppressed when pair partner is massive and close
                float partner_mass = de_a ? (1.0 / max(get_mass_inv(type_b), 0.001))
                                          : (1.0 / max(mass_inv_a, 0.001));
                float screen_range = 30.0;  // screening kicks in within this distance
                float density_proxy = partner_mass * exp(-dist / screen_range);
                float screening = 1.0 / (1.0 + density_proxy * 0.01);  // 0→1: screened→free
                de_force *= screening;
            }

            total_force -= normal * de_force;
            continue;  // dark energy doesn't participate in other forces
        }

        // ── Per-pair cached lookups (avoid redundant buffer reads) ───────────
        float charge_b   = get_charge(uint(j));
        float mass_inv_b = get_mass_inv(type_b);

        local_density += exp(-dist / (MAX_RADIUS * 0.5));

        // ── 0. Zeroth Law: Thermal conduction (velocity exchange) ────────────
        // Close particles exchange momentum toward thermal equilibrium.
        // Hot regions cool, cold regions warm — heat flows naturally.
        if (dist < 30.0 && !dm_interaction) {
            vec2 vel_b = in_vel_buffer.data[j];
            vec2 dv = vel_b - vel_a;
            float cond_coupling = 0.0005 / (dist + 1.0);
            float mass_factor = sqrt(mass_inv_a * mass_inv_b);
            total_force += dv * cond_coupling * mass_factor;
        }

        // ── 1. Soft-body repulsion (universal, skip for DM-normal interactions) ─
        if (dist < params.repulsion_radius && !dm_interaction) {
            float overlap = 1.0 - dist * inv_repulsion_radius;
            total_force -= normal * overlap * params.pressure_resistance;
        }

        // ── 2. Yukawa nuclear force (baryon-baryon, skip for DM) ─────────────
        // Tighter cutoff than raw exponential: full strength within nucleus
        // (0–8 px), smooth fade to zero by 12 px.  This prevents nucleons
        // from separate atoms being dragged together by the Yukawa tail.
        if (is_baryon(type_a) && is_baryon(type_b) && !dm_interaction) {
            if (dist < YUKAWA_RANGE) {
                float inv_r = 1.0 / max(dist, 0.5);
                float yukawa_F = params.yukawa_strength * YUKAWA_COUPLING * exp(-dist * inv_yukawa_range)
                                 * (inv_r + inv_yukawa_range) * inv_r;

                // Smooth window: full strength within 4px, fades to 0 by 7px
                // Tight cutoff prevents nucleons from separate atoms merging
                float window = 1.0 - smoothstep(YUKAWA_RANGE * 0.5, YUKAWA_RANGE * 0.875, dist);
                total_force += normal * yukawa_F * window;

                if (dist < PAULI_CORE) {
                    float overlap = 1.0 - dist / PAULI_CORE;
                    float pauli = params.pauli_multiplier * PAULI_STRENGTH * overlap * overlap / (dist * dist + 0.05);
                    total_force -= normal * pauli;
                }

                if (dist < YUKAWA_RANGE) {
                    interaction_energy += 0.004 * params.dt;
                }
            }
        }

        // ── 3. Coulomb electrostatic force (skip for DM) ──────────────────
        if (!dm_interaction) {
            float q_prod = charge_a * charge_b;
            if (abs(q_prod) > 0.001) {
                float soften_sq = max(SOFTEN_MIN * SOFTEN_MIN,
                                      params.repulsion_radius * 0.5 * params.repulsion_radius * 0.5);

                // Running QED coupling: α(Q²) increases at short distances
                // α(Q²) = α₀ / (1 - α₀/(3π) · ln(Q²/mₑ²))
                float alpha_em = 1.0 / 137.036;
                float log_Q2 = max(0.0, -log(max(dist_sq, 1.0)));
                float alpha_run = alpha_em / max(0.5, 1.0 - alpha_em / (3.0 * 3.14159) * log_Q2);
                float running_scale = alpha_run / alpha_em;

                float coulomb = params.coulomb_strength * K_COULOMB * running_scale * q_prod / (dist_sq + soften_sq);
                total_force -= normal * coulomb;

                if (q_prod < 0.0 && dist < params.interaction_radius * 0.5) {
                    interaction_energy += 0.005 * params.dt;
                }
            }
        }

        // ── 3b. Track nearest nucleus for centrifugal barrier ──────────
        // (Applied ONCE after loop to avoid N× force from multi-nucleon nuclei)
        // Electrons orbit protons only (Coulomb attraction from +charge).
        // Positrons orbit antiprotons only (antimatter counterpart).
        // Neutrons are neutral — no Coulomb binding, so never a valid orbital center.
        if (is_light_particle) {
            bool valid_nucleus = false;
            if (charge_a < -0.01) {
                valid_nucleus = (type_b == PROTON_TYPE);
            } else if (charge_a > 0.01) {
                valid_nucleus = (type_b == ANTIPROTON_TYPE);
            }
            if (valid_nucleus && dist < closest_nuc_dist) {
                closest_nuc_dist = dist;
                closest_nuc_delta = delta;
                closest_nuc_vel = in_vel_buffer.data[j];
            }
        }

        // ── 4. Color confinement (Cornell potential: quarks + gluon neighbors) ─
        if (is_colored(flags_a) && is_colored(flags_b)) {
            float color_b = get_color(uint(j));
            float cf = color_factor_gluon(color_a, color_b, flags_a, flags_b);

            if (abs(cf) > 0.01) {
                // Cornell: F = -alpha_s/r^2 (short-range) + sigma*r (confinement)
                float sigma = params.string_tension;
                float inv_r = 1.0 / max(dist, 0.5);

                // Short-range color Coulomb with running coupling (asymptotic freedom)
                // α_s decreases at short distances, increases at long distances
                float alpha_eff = params.alpha_s_scale * COLOR_ALPHA_S * max(0.3, 1.0 + 0.3 * log(max(dist, 0.5)));
                float short_range = alpha_eff * inv_r * inv_r;
                // Linear confinement: V=σr → F=σ (constant string tension)
                float confine = sigma * 0.1;

                float cornell_F = cf * (-short_range - confine);
                total_force += normal * cornell_F;

                // Hard-core repulsion for quarks at very close range
                if (dist < 2.0) {
                    float core = 800.0 / (dist * dist + 0.1);
                    total_force -= normal * core;
                }

                // String breaking signal: drain energy when too far apart
                if (cf < -0.5 && dist > 40.0) {
                    interaction_energy -= 0.3 * params.dt;
                }

                // Binding energy for close quarks
                if (dist < 15.0 && cf < 0.0) {
                    interaction_energy += 0.006 * params.dt;
                }
            }
        }

        // ── 5. Gravity (optional) ───────────────────────────────────────────
        // GR extensions: mass-energy equivalence, frame-dragging, gravitational waves
        {
            float mass_b_rest = 1.0 / max(mass_inv_b, 0.00001);

            // 5a. Mass-energy equivalence: m_grav = m_rest × γ (E=mc²)
            bool gr_mass_energy = (params.field_flags & (1u << 9)) != 0u;
            float m_a_grav = mass;       // mass = 1/mass_inv_a (precomputed)
            float m_b_grav = mass_b_rest;
            if (gr_mass_energy) {
                float beta_a = min(length(vel_a) * inv_c_sim, 0.999);
                m_a_grav *= inversesqrt(max(1.0 - beta_a * beta_a, 0.0001));
                vec2 vb_gr = in_vel_buffer.data[j];
                float beta_b = min(length(vb_gr) * inv_c_sim, 0.999);
                m_b_grav *= inversesqrt(max(1.0 - beta_b * beta_b, 0.0001));
            }
            float mass_prod = m_a_grav * m_b_grav;

            // 5b. Gravitational waves: retarded-time gravity (finite propagation at c)
            bool gr_gw = (params.field_flags & (1u << 11)) != 0u;
            vec2  grav_normal  = normal;
            float grav_dist_sq = dist_sq;
            if (gr_gw) {
                vec2 vb_gw = in_vel_buffer.data[j];
                float retard = dist * inv_c_sim;        // r/c delay
                vec2 retarded_delta = delta - vb_gw * retard;
                grav_dist_sq = dot(retarded_delta, retarded_delta);
                float rd = sqrt(grav_dist_sq + 25.0);
                grav_normal = retarded_delta / rd;
            }

            // DM self-gravity: always on, enhanced (forms halos)
            if (dm_a && dm_b) {
                float f_grav = 20.0 * mass_prod / (grav_dist_sq + 25.0);
                total_force += grav_normal * f_grav;
            }
            // SIMP self-interaction: 30x self-gravity between SIMP pairs
            if (type_a == SIMP_TYPE && type_b == SIMP_TYPE) {
                float f_simp = 30.0 * mass_prod / (grav_dist_sq + 25.0);
                total_force += grav_normal * f_simp;
            }
            // DM-normal gravity: always on but weaker
            else if (dm_interaction) {
                float f_grav = 5.0 * mass_prod / (grav_dist_sq + 25.0);
                total_force += grav_normal * f_grav;
            }
            // Normal gravity (slider-controlled)
            // F = G·m1·m2 / r²  (Newton's law, slider 1.0 = vanilla)
            else if (params.gravity_strength > 0.001) {
                float f_grav = params.gravity_strength * mass_prod
                               / (grav_dist_sq + 25.0);
                total_force += grav_normal * f_grav;
            }

            // 5c. Frame-dragging (gravitomagnetic Lense-Thirring analog)
            // Spinning mass drags nearby moving masses tangentially — 1/c² correction
            bool gr_frame_drag = (params.field_flags & (1u << 10)) != 0u;
            if (gr_frame_drag && params.gravity_strength > 0.001) {
                float spin_b_fd = get_spin(uint(j));
                float J_b = spin_b_fd * m_b_grav;      // source angular momentum
                float r3_soft = dist * dist_sq + 100.0; // r³ + softening
                float gm_k = params.gravity_strength * 0.01; // ~1% of Newton
                vec2 tangent = vec2(-normal.y, normal.x);
                float v_tan = dot(vel_a, tangent);
                total_force += tangent * (gm_k * J_b * v_tan * m_a_grav / r3_soft);
            }
        }

        // ── 6. Magnetic force (Biot-Savart + nucleon dipoles, skip DM) ────
        // 6a. Moving charges → Biot-Savart B-field (1/r² falloff)
        //     All particles accumulate B for spin-moment coupling (section 9).
        //     Only charged particles feel direct Lorentz force: F = q·(v × B).
        // 6b. Nucleon intrinsic magnetic dipoles (1/r³ falloff)
        //     Proton:  μ_p = +2.793 μ_N (anomalous, quark substructure)
        //     Neutron: μ_n = −1.913 μ_N (nonzero despite q=0 — key evidence for quarks)
        if (!dm_interaction) {
            // 6a. Biot-Savart: B from moving charges
            if (abs(charge_b) > 0.01) {
                vec2  vel_b   = in_vel_buffer.data[j];
                float cross_j = vel_b.x * (-normal.y) - vel_b.y * (-normal.x);
                float coupling = params.lorentz_strength * K_MAGNETIC;
                float B_z     = coupling * charge_b * cross_j / (dist_sq + 1.0);
                accumulated_Bz += B_z;  // ALL particles accumulate B (neutrons too)
                // Charged particles feel direct Lorentz force: F = q(v×B)
                if (abs(charge_a) > 0.01) {
                    nearby_charge_sum += abs(charge_b);
                    total_force += charge_a * B_z * vec2(vel_a.y, -vel_a.x);
                }
            }

            // 6b. Intrinsic magnetic dipole
            // Nucleons: anomalous magnetic moments (dominant at nuclear distances)
            // Charged leptons: Dirac moment μ = q/(2m), scaled by spin
            // All spin dipoles: B ∝ μ·spin/r³, separate from velocity-dependent Biot-Savart
            {
                float mu_intrinsic = 0.0;
                if (type_b == PROTON_TYPE)
                    mu_intrinsic = MU_PROTON_ANOM;
                else if (type_b == ANTIPROTON_TYPE)
                    mu_intrinsic = -MU_PROTON_ANOM;  // CPT symmetry
                else if (type_b == NEUTRON_TYPE)
                    mu_intrinsic = MU_NEUTRON;
                else if (abs(charge_b) > 0.01) {
                    // Dirac moment for any other charged particle (electrons, muons, quarks)
                    // μ ∝ charge/mass, normalized so electron ≈ 1 Bohr magneton
                    float mass_b = 1.0 / max(mass_inv_b, 0.001);
                    mu_intrinsic = charge_b * 0.511 / max(mass_b, 0.1);
                }

                if (abs(mu_intrinsic) > 0.001) {
                    // mu_intrinsic is already the FULL magnetic moment
                    // (MU_PROTON_ANOM=2.793μ_N includes g×S, Dirac formula includes g=2×S=0.5)
                    // Do NOT multiply by spin again — that would halve all moments
                    float r3     = dist * dist_sq + 1.0;  // r³ + softening
                    float B_dip  = params.lorentz_strength * K_DIPOLE
                                 * mu_intrinsic / r3;
                    accumulated_Bz += B_dip;

                    // Charged particles also feel direct Lorentz from dipole B
                    if (abs(charge_a) > 0.01) {
                        total_force += charge_a * B_dip * vec2(vel_a.y, -vel_a.x);
                    }
                }
            }

            // 6c. Magnetic monopole: static radial B = g/r²
            if (type_b == MONOPOLE_TYPE && abs(charge_a) > 0.01) {
                float g_mono = 200.0;
                float B_mono = g_mono / (dist_sq + 4.0);
                total_force += charge_a * B_mono * vec2(vel_a.y, -vel_a.x);
            }
            if (type_a == MONOPOLE_TYPE && abs(charge_b) > 0.01) {
                float g_mono = 200.0;
                float B_mono = g_mono / (dist_sq + 4.0);
                vec2 vel_b = in_vel_buffer.data[j];
                total_force -= charge_b * B_mono * vec2(vel_b.y, -vel_b.x) * mass_inv_a;
            }
        }

        // ── 7. Weak force (CC/NC split with chirality) ──────────────────────
        if (params.weak_coupling > 0.001 && dist < 3.0) {
            // Chirality: left-handed particles (spin>0), left-handed antiparticles (spin<0)
            float spin_b_w = get_spin(uint(j));
            bool left_a = (charge_a >= 0.0) ? (spin_a > 0.0) : (spin_a < 0.0);
            bool left_b = (charge_b >= 0.0) ? (spin_b_w > 0.0) : (spin_b_w < 0.0);
            float chiral_factor = (left_a && left_b) ? 1.0 : 0.0;

            // NC (Z-mediated): all fermions, reduced for right-handed
            float nc_coupling = 0.3 + 0.7 * chiral_factor;
            float nc_F = params.weak_coupling * 100.0 * nc_coupling * exp(-dist / 0.8) / max(dist_sq, 0.1);
            total_force += normal * nc_F;

            // CC (W-mediated): only left-handed isospin partners (up-type ↔ down-type)
            if (chiral_factor > 0.5) {
                // Check if quarks form an isospin doublet (up↔down, charm↔strange, top↔bottom)
                bool cc_pair = false;
                // Up-type quarks: 13(u),16(c),17(t) paired with down-type: 14(d),15(s),18(b)
                if ((type_a == UP_QUARK && type_b == DOWN_QUARK) || (type_a == DOWN_QUARK && type_b == UP_QUARK)) cc_pair = true;
                if ((type_a == CHARM_QUARK && type_b == STRANGE_QUARK) || (type_a == STRANGE_QUARK && type_b == CHARM_QUARK)) cc_pair = true;
                if ((type_a == TOP_QUARK && type_b == BOTTOM_QUARK) || (type_a == BOTTOM_QUARK && type_b == TOP_QUARK)) cc_pair = true;
                // Leptons: e↔νe, μ↔νμ, τ↔ντ
                if ((type_a == ELECTRON_TYPE && type_b == NEUTRINO_E_TYPE) || (type_a == NEUTRINO_E_TYPE && type_b == ELECTRON_TYPE)) cc_pair = true;
                if ((type_a == MUON_TYPE && type_b == NEUTRINO_MU_TYPE) || (type_a == NEUTRINO_MU_TYPE && type_b == MUON_TYPE)) cc_pair = true;
                if ((type_a == TAU_TYPE && type_b == NEUTRINO_TAU_TYPE) || (type_a == NEUTRINO_TAU_TYPE && type_b == TAU_TYPE)) cc_pair = true;
                if (cc_pair) {
                    float cc_F = params.weak_coupling * 150.0 * exp(-dist / 0.6) / max(dist_sq, 0.1);
                    total_force += normal * cc_F;
                }
            }
        }

        // ── 8. Spin-based Pauli exclusion (identical fermions) ──────────────
        if (type_a == type_b && dist < PAULI_CORE * 2.0) {
            float spin_b = get_spin(uint(j));
            if (abs(spin_a - spin_b) < 0.1) {
                // Same type + same spin → extra repulsion (capped for light particles)
                float pauli_extra = params.pauli_multiplier * 150.0 / (dist * dist + 1.0);
                total_force -= normal * pauli_extra;
            }
        }

        // ── 8b. Hard-sphere collision accumulation (massive pairs) ────────
        // Accumulate position corrections from ALL overlapping neighbors.
        // After integration, pos_a is snapped outward to resolve ALL overlaps.
        // Baryons use a larger hard-sphere (nucleon size) so separate atoms
        // bounce instead of merging.  Colored pairs governed by Cornell.
        bool both_baryons = is_baryon(type_a) && is_baryon(type_b);
        bool both_colored = is_colored(flags_a) && is_colored(flags_b);
        if (!dm_interaction && !both_colored) {
            if (is_massive_a && mass_inv_b < 10.0) {
                // Baryons: tight safety net (1.5px) — Pauli force handles smooth repulsion
                float MIN_SEP = both_baryons ? PAULI_CORE * 0.25 : params.radius * 2.0;
                float penetration = MIN_SEP - dist;
                if (penetration > 0.0) {
                    // Push away from each overlapping neighbor
                    collision_push -= normal * penetration;

                    // Track strongest inward collision for elastic velocity response
                    float vn = dot(vel_a, normal);  // velocity toward neighbor
                    if (vn > max_vn) {
                        max_vn = vn;
                        max_vn_normal = normal;
                        max_vn_mass_b = (mass_inv_b > 0.001) ? 1.0 / mass_inv_b : 1000.0;
                    }
                }
            }
        }

        // ── 10. Matter-antimatter annihilation ──────────────────────────────
        // NOTE: Annihilation is a quantum process at zero range. The constant
        // attraction here aids pair collision; real attraction is EM (Coulomb above).
        if (is_annihilation_pair(type_a, type_b) && dist < ANNIHIL_RADIUS) {
            total_force += normal * ANNIHIL_ATTRACTION * params.annihilation_strength;
            interaction_energy -= energy * ANNIHIL_DRAIN * params.annihilation_strength * params.dt;
        }
    } // g_k (particles in cell)
    } // cx
    } // cy

    // ── Orbital confinement + tangential drive (applied ONCE per electron) ──
    // genome[2] stores L_ground from CPU orbital assignment (0 = free electron)
    if (is_light_particle && closest_nuc_dist < params.interaction_radius) {
        float L_ground = get_color(i);  // genome[2] repurposed for orbital L
        if (L_ground < 1.0) L_ground = L_MIN;  // free electron: default

        vec2 nuc_normal = closest_nuc_delta / max(closest_nuc_dist, 0.1);
        vec2 nuc_tangent = vec2(-nuc_normal.y, nuc_normal.x);

        // Velocity relative to parent nucleus (must not fight bulk atom motion)
        vec2 rel_vel = vel_a - closest_nuc_vel;

        // Per-electron orbital boost from genome[3] (set by CPU from SimConfig).
        // Positive value = boost factor; 0 or negative = use steeper default.
        float stored_boost = get_decay(i);
        float ORBIT_BOOST = (stored_boost > 0.5) ? stored_boost
            : mix(1.5, 9.0, clamp((closest_nuc_dist - 8.0) / 72.0, 0.0, 1.0));

        // ── Centrifugal barrier (L_ground only) ───────────────────────
        // Prevents electron from collapsing into the nucleus.
        float r3 = closest_nuc_dist * closest_nuc_dist * closest_nuc_dist + CENTRIFUGAL_SOFTEN;
        float F_centrifugal = min(L_ground * L_ground * mass_inv_a / r3, 300.0);
        total_force -= nuc_normal * F_centrifugal;

        // ── Extra binding for boosted orbital speed ───────────────────
        // At ORBIT_BOOST× speed, need BOOST²× centripetal. Coulomb gives 1×,
        // add (BOOST²-1)×. Outer electrons get much stronger binding
        // (BOOST=5 → 24× extra), keeping the cloud tightly confined.
        float r2_soft = closest_nuc_dist * closest_nuc_dist + CENTRIFUGAL_SOFTEN;
        float F_bind = (ORBIT_BOOST * ORBIT_BOOST - 1.0) * K_COULOMB * abs(charge_a) / r2_soft;
        total_force += nuc_normal * F_bind;

        // ── Asymmetric radial damping (outward only) ──────────────────
        // Only damp OUTWARD radial motion to prevent escape. Symmetric
        // damping bleeds orbital energy due to rotating reference frame.
        float v_rad = dot(rel_vel, nuc_normal);  // positive = moving away
        if (v_rad > 0.0) {
            total_force -= nuc_normal * v_rad * 20.0;
        }

        // ── Orbital tangential drive ──────────────────────────────────
        // Drive to boosted speed. Uses L_ground only (not L_actual) to
        // avoid runaway feedback.
        float mass_e = 1.0 / max(mass_inv_a, 0.001);
        float target_v_tan = L_ground / (mass_e * max(closest_nuc_dist, 1.0));
        target_v_tan *= ORBIT_BOOST;
        float v_tan_rel = dot(rel_vel, nuc_tangent);

        // Consistent orbit direction per particle (half CW, half CCW)
        float orbit_sign = (i % 2u == 0u) ? 1.0 : -1.0;
        // If already orbiting in one direction, keep that direction
        if (abs(v_tan_rel) > target_v_tan * 0.1)
            orbit_sign = sign(v_tan_rel);

        float dv = target_v_tan * orbit_sign - v_tan_rel;
        float drive_k = 15.0;
        total_force += nuc_tangent * dv * drive_k;

        // Spin-orbit coupling
        float L_actual = abs(closest_nuc_delta.x * rel_vel.y - closest_nuc_delta.y * rel_vel.x);
        float F_SO = spin_a * L_actual * K_SPIN_ORBIT
                   / (closest_nuc_dist * closest_nuc_dist * closest_nuc_dist * closest_nuc_dist + 1.0);
        total_force -= nuc_normal * F_SO;
    }

    // ── 9. Spin magnetic moment: μ·∇B (force in external B-field) ─────
    // Magnetic dipoles feel F = ∇(μ·B) in external B-field gradients.
    // Moment values are the FULL magnetic moment (g×S already included):
    //   Proton:  μ_p = +2.793 μ_N  (anomalous, g_p ≈ 5.586)
    //   Neutron: μ_n = −1.913 μ_N  (nonzero despite q=0, from quark substructure)
    //   Quarks:  μ_q = (g_eff/2)·q·S/m  with g_eff ≈ 2.10 (QCD correction)
    //   Leptons: μ = q·m_e/(m) Bohr magnetons  (Dirac g=2, S=1/2 built in)
    if (abs(accumulated_Bz) > 0.001) {
        float mu_eff = 0.0;
        if (type_a == PROTON_TYPE)
            mu_eff = MU_PROTON_ANOM * mass_inv_a;
        else if (type_a == ANTIPROTON_TYPE)
            mu_eff = -MU_PROTON_ANOM * mass_inv_a;
        else if (type_a == NEUTRON_TYPE)
            mu_eff = MU_NEUTRON * mass_inv_a;
        else if (is_quark_type(flags_a) || (flags_a & BEHAVIOR_ANTIQUARK) != 0u) {
            // Quarks: full moment = g_eff × S × q / m = 2.10 × 0.5 × q / m = 1.05 × q / m
            mu_eff = 1.05 * charge_a * mass_inv_a;
        }
        else if (abs(charge_a) > 0.01 && abs(spin_a) > 0.01)
            mu_eff = charge_a * 0.511 * mass_inv_a;  // Dirac: μ = q × m_e/m (full moment)

        if (abs(mu_eff) > 0.0001) {
            float grad_scale = 0.05;  // phenomenological B-gradient length scale
            total_force += mu_eff * accumulated_Bz * grad_scale * vec2(vel_a.y, -vel_a.x);
        }
    }

    // ── Force Object effects (stationary emitters, max 8) ──────────────────
    for (uint fo = 0u; fo < params.force_object_count; fo++) {
        if (force_objects.data[fo].is_active == 0u) continue;

        vec2  fo_pos    = vec2(force_objects.data[fo].x, force_objects.data[fo].y);
        float fo_str    = force_objects.data[fo].strength;
        float fo_radius = force_objects.data[fo].radius;
        uint  fo_type   = force_objects.data[fo].force_type;
        if (fo_type == 5u) continue;  // mirror — handled post-integration

        vec2  fo_delta  = fo_pos - pos_a;
        float fo_dist   = length(fo_delta);
        if (fo_dist < 1.0 || fo_dist > fo_radius) continue;

        float inv_fo_dist    = 1.0 / fo_dist;
        float fo_dist_sq     = fo_dist * fo_dist;
        vec2  fo_normal      = fo_delta * inv_fo_dist;

        if (fo_type == 0u) {
            // EM FIELD: electric (Coulomb) + magnetic (Lorentz) on charged particles
            // E-field: radial, F = qE/r² — does work, accelerates/decelerates
            // B-field: perpendicular, F = q(v×B) — no work, only deflects
            if (abs(charge_a) > 0.01) {
                float fo_t = fo_dist / fo_radius;
                float falloff = max(0.0, 1.0 - fo_t * fo_t);  // smooth quadratic

                // Electric component: Coulomb-like radial force
                float E_r = fo_str * 500.0 * falloff / (fo_dist_sq + 4.0);
                total_force += charge_a * E_r * fo_normal;

                // Magnetic component: Lorentz deflection
                float B_z = fo_str * falloff;
                total_force += charge_a * B_z * vec2(vel_a.y, -vel_a.x);
            }
        }
        else if (fo_type == 1u) {
            // STRONG NUCLEAR: Yukawa-like short-range attraction on baryons
            if (is_baryon(type_a)) {
                float yukawa = fo_str * YUKAWA_COUPLING * 0.5
                             * exp(-fo_dist / (YUKAWA_RANGE * 3.0))
                             * max(inv_fo_dist, 2.0);
                total_force += fo_normal * yukawa;
            }
        }
        else if (fo_type == 2u) {
            // WEAK FORCE: short-range boost on all particles
            float weak_range = min(fo_radius, 30.0);
            if (fo_dist < weak_range) {
                float weak_F = fo_str * 100.0 * exp(-fo_dist / 5.0) / max(fo_dist_sq, 0.1);
                total_force += fo_normal * weak_F;
            }
        }
        else if (fo_type == 3u) {
            // GRAVITY WELL: gravitational attraction on all massive particles
            float f_grav = fo_str * mass * 200.0 / (fo_dist_sq + 25.0);
            total_force += fo_normal * f_grav;
        }
        else if (fo_type == 4u) {
            // HEAT SOURCE: thermal noise boost (extra random velocity kick)
            float fo_t = fo_dist / fo_radius;
            float falloff = 1.0 - fo_t;
            falloff *= falloff;
            uint heat_seed = (i * 1664525u + params.step * 4789u + fo * 65537u) ^ 0xdeadbeefu;
            heat_seed ^= (heat_seed >> 17u);
            heat_seed *= 0xbf58476du;
            heat_seed ^= (heat_seed >> 31u);
            float heat_angle = float(heat_seed) * (6.28318 / 4294967296.0);
            vec2  heat_dir = vec2(cos(heat_angle), sin(heat_angle));
            // Apply as force (will be integrated via relativistic momentum update)
            total_force += heat_dir * fo_str * 3.0 * falloff * mass;
        }
        else if (fo_type == 6u) {
            // COULOMB SOURCE: pure electrostatic point charge
            // F = kqQ/r² radially — positive strength = positive charge
            // (repels same-sign, attracts opposite-sign charged particles)
            if (abs(charge_a) > 0.01) {
                float E_coulomb = fo_str * 800.0 / (fo_dist_sq + 4.0);
                total_force += charge_a * E_coulomb * fo_normal;
            }
        }
        else if (fo_type == 7u) {
            // VORTEX: tangential force creating circular motion (cyclotron)
            // F ∝ mass/r toward tangent direction — heavier particles orbit wider
            // Positive strength = counterclockwise, negative = clockwise
            vec2 tangent = vec2(-fo_normal.y, fo_normal.x);
            float vortex_F = fo_str * mass * 50.0 / (fo_dist + 5.0);
            total_force += tangent * vortex_F;
        }
        else if (fo_type == 8u) {
            // POTENTIAL WELL: harmonic trap F = -k*r (restoring force)
            // All particles attracted toward center proportional to displacement
            // Creates oscillatory motion — useful as a particle trap
            float spring_F = fo_str * mass * 8.0 * fo_dist / fo_radius;
            total_force += fo_normal * spring_F;
        }
    }

    // ── Pre-integration cached values ──────────────────────────────────────
    float spd = length(vel_a);

    // ── Energy metabolism ────────────────────────────────────────────────────
    {
        float delta_e = 0.0;

        // Synchrotron radiation: only charged particles radiate (P ∝ q²γ²v²)
        // Coefficient tuned so radiation is a subtle long-term drain, not immediate
        if (abs(charge_a) > 0.01) {
            float beta_e = min(spd * inv_c_sim, 0.9999);
            float gamma_e = inversesqrt(max(1.0 - beta_e * beta_e, 0.0001));
            delta_e -= charge_a * charge_a * gamma_e * gamma_e
                     * spd * spd * 5e-10 * params.dt;
        }

        delta_e += interaction_energy;
        if (params.vacuum_energy > 0.001)
            delta_e += params.vacuum_energy * 0.003 * params.dt;

        // Decay drain from genome[3] (virtual particles use negative sign as marker)
        // For electrons/positrons, positive genome[3] = orbital boost factor, not decay.
        float decay_rate = get_decay(i);
        bool is_orbital_boost = (type_a == ELECTRON_TYPE || type_a == POSITRON_TYPE)
                                && decay_rate > 0.0;
        float abs_decay = abs(decay_rate);
        if (abs_decay > 0.001 && !is_orbital_boost) {
            delta_e -= abs_decay * params.dt;
        }

        // Third Law: enforce per-type zero-point energy floor
        float zpe = get_zpe(type_a);
        energy = clamp(energy + delta_e, zpe, 1.0);
    }
    out_energy_buffer.data[i] = energy;

    // ── Covalent bond spring forces ─────────────────────────────────────────
    {
        const float BOND_K    = 500.0;  // spring constant (strong enough to resist Coulomb)
        const float BOND_REST = 36.0;   // rest length (px) — must exceed nuclear extents
        const float BOND_DAMP = 2.0;    // velocity damping along bond axis
        for (uint s = 0u; s < 6u; s++) {
            uint partner = bond_buffer.data[i * 6u + s];
            if (partner == 0xFFFFFFFFu || partner >= params.particle_count) continue;
            vec2 p_pos = in_pos_buffer.data[partner];
            vec2 delta = p_pos - pos_a;
            float dist = length(delta);
            if (dist < 0.001) continue;
            vec2 dir = delta / dist;
            // Hooke's law: F = k * (x - x0)
            float displacement = dist - BOND_REST;
            total_force += dir * BOND_K * displacement;
            // Dashpot damping along bond axis
            vec2 p_vel = in_vel_buffer.data[partner];
            float rel_v = dot(p_vel - vel_a, dir);
            total_force += dir * BOND_DAMP * rel_v;
        }
    }

    // ── Relativistic Integration (dp/dt = F) ────────────────────────────────
    // Special Relativity: momentum p = γmv, velocity derived from momentum
    // v = pc / √(m²c² + p²) — naturally limits |v| < c
    {
        // Current Lorentz factor from velocity
        float beta = min(spd * inv_c_sim, 0.9999);
        float gamma = inversesqrt(max(1.0 - beta * beta, 0.0001));

        // Current relativistic momentum: p = γmv
        vec2 momentum = gamma * mass * vel_a;

        // Force impulse: dp = F·dt (force, NOT acceleration)
        momentum += total_force * params.dt;

        // Viscosity damping on momentum (radiation/medium losses)
        // Bethe-Bloch MIP effect: high-energy particles penetrate with less
        // energy loss — dE/dx ∝ 1/β² at low speed, minimum at βγ≈3-4.
        // Scale damping loss inversely with γ so relativistic particles
        // pass through dense regions without artificial deceleration.
        float viscosity_factor = clamp(local_density * params.viscosity_strength, 0.0, 0.9);
        float effective_damp = params.dampening * (1.0 - viscosity_factor);
        float damp_loss = 1.0 - clamp(effective_damp, 0.0, 0.99);
        damp_loss /= max(gamma, 1.0);
        momentum *= (1.0 - damp_loss);

        // Thermal noise as momentum impulse (equipartition: δp ∝ √m)
        if (params.temperature > 0.001) {
            uint bm_seed = (i * 1664525u + params.step * 1013904223u) ^ 0x9e3779b9u;
            bm_seed ^= (bm_seed >> 17u); bm_seed *= 0xbf58476du; bm_seed ^= (bm_seed >> 31u);
            float rng_angle = float(bm_seed) * (6.28318 / 4294967296.0);
            vec2  noise_dir = vec2(cos(rng_angle), sin(rng_angle));
            momentum += noise_dir * params.temperature * 2.0 * sqrt(mass);
        }

        // Derive velocity from momentum: v = pc / √(m²c² + p²)
        float p_sq = dot(momentum, momentum);
        float mc = mass * C_SIM;
        vel_a = momentum * C_SIM * inversesqrt(mc * mc + p_sq);
    }

    pos_a += vel_a * params.dt;

    // ── Hard-sphere collision: absolute position + elastic velocity ─────
    // Both particles independently push → each applies half correction → net = full.
    // Momentum-conserving elastic collision with slight inelasticity for stability.
    if (dot(collision_push, collision_push) > 0.000001) {
        // Position: gentle correction (smooths out over several frames)
        pos_a += collision_push * 0.15;

        // Velocity: elastic collision impulse along strongest collision normal
        if (max_vn > 0.0) {
            float e = 0.95;  // coefficient of restitution (slightly inelastic)
            float impulse = (1.0 + e) * max_vn * max_vn_mass_b / (mass + max_vn_mass_b);
            vel_a -= max_vn_normal * impulse;
        }
    }

    // ── Mirror reflection (post-integration) ─────────────────────────────
    vec2 pre_pos = in_pos_buffer.data[i];  // position before this frame's integration
    for (uint mfo = 0u; mfo < params.force_object_count; mfo++) {
        if (force_objects.data[mfo].is_active == 0u) continue;
        if (force_objects.data[mfo].force_type != 5u) continue;

        vec2  m_a = vec2(force_objects.data[mfo].x, force_objects.data[mfo].y);
        vec2  m_b = vec2(force_objects.data[mfo]._pad0, force_objects.data[mfo]._pad1);
        float elasticity = force_objects.data[mfo].strength;
        float thickness  = force_objects.data[mfo].radius;

        vec2  seg = m_b - m_a;
        float seg_len2 = dot(seg, seg);
        if (seg_len2 < 0.001) continue;

        vec2 seg_dir = normalize(seg);
        vec2 normal = vec2(-seg_dir.y, seg_dir.x);

        // Proximity test: particle currently within mirror thickness
        float t_proj = clamp(dot(pos_a - m_a, seg) / seg_len2, 0.0, 1.0);
        vec2  closest = m_a + t_proj * seg;
        vec2  delta = pos_a - closest;
        float dist = length(delta);

        bool hit = false;
        if (dist < thickness && dist > 0.001) {
            if (dot(normal, delta) < 0.0) normal = -normal;
            hit = (dot(vel_a, normal) < 0.0);
        } else {
            // Swept collision: check if path (pre_pos → pos_a) crossed mirror segment
            // Handles fast particles (photons, bosons) that tunnel through in one frame
            vec2 d_path = pos_a - pre_pos;
            float cross_denom = d_path.x * seg.y - d_path.y * seg.x;
            if (abs(cross_denom) > 0.0001) {
                vec2 d_orig = m_a - pre_pos;
                float t1 = (d_orig.x * seg.y - d_orig.y * seg.x) / cross_denom;
                float t2 = (d_orig.x * d_path.y - d_orig.y * d_path.x) / cross_denom;
                if (t1 > 0.0 && t1 <= 1.0 && t2 >= 0.0 && t2 <= 1.0) {
                    // Path crossed mirror — orient normal against velocity
                    if (dot(normal, vel_a) > 0.0) normal = -normal;
                    hit = true;
                }
            }
        }

        if (hit) {
            float vn = dot(vel_a, normal);
            vel_a -= (1.0 + elasticity) * vn * normal;
            t_proj = clamp(dot(pos_a - m_a, seg) / seg_len2, 0.0, 1.0);
            closest = m_a + t_proj * seg;
            pos_a = closest + normal * (thickness + 0.1);
        }
    }

    out_pos_buffer.data[i] = pos_a;
    out_vel_buffer.data[i] = vel_a;
    angle_out_buffer.data[i] = angle_in_buffer.data[i];
    avel_out_buffer.data[i]  = avel_in_buffer.data[i];
}

// ═══════════════════════════════════════════════════════════════════════════════
//  FORCE OBJECT RENDERING
// ═══════════════════════════════════════════════════════════════════════════════

void render_force_object(uint fo_idx) {
    float fo_x     = force_objects.data[fo_idx].x;
    float fo_y     = force_objects.data[fo_idx].y;
    uint  fo_type  = force_objects.data[fo_idx].force_type;
    float fo_str   = force_objects.data[fo_idx].strength;

    vec2 screen_center = params.region_size * 0.5;
    vec2 center = screen_center + (vec2(fo_x, fo_y) - params.camera_origin) * params.camera_zoom;

    // Neutron-sized core
    float core_radius = params.radius * params.camera_zoom * 0.7;
    // Aura extends further
    float aura_radius = core_radius * (3.0 + fo_str * 1.5);
    aura_radius = min(aura_radius, 40.0);

    int range = int(ceil(aura_radius));
    if (center.x + float(range) < 0.0 || center.x - float(range) > params.region_size.x) return;
    if (center.y + float(range) < 0.0 || center.y - float(range) > params.region_size.y) return;

    // Per-type colors
    vec3 aura_color, core_color;
    if (fo_type == 0u) {
        aura_color = vec3(0.3, 0.5, 1.0);   core_color = vec3(0.4, 0.6, 1.0);   // EM: blue
    } else if (fo_type == 1u) {
        aura_color = vec3(0.1, 0.8, 0.3);   core_color = vec3(0.2, 0.9, 0.4);   // Strong: green
    } else if (fo_type == 2u) {
        aura_color = vec3(0.6, 0.2, 0.9);   core_color = vec3(0.7, 0.3, 1.0);   // Weak: purple
    } else if (fo_type == 3u) {
        aura_color = vec3(0.8, 0.5, 0.2);   core_color = vec3(0.9, 0.6, 0.3);   // Gravity: amber
    } else if (fo_type == 6u) {
        aura_color = vec3(0.9, 0.3, 0.3);   core_color = vec3(1.0, 0.4, 0.3);   // Coulomb: red
    } else if (fo_type == 7u) {
        aura_color = vec3(0.2, 0.8, 0.9);   core_color = vec3(0.3, 0.9, 1.0);   // Vortex: cyan
    } else if (fo_type == 8u) {
        aura_color = vec3(0.9, 0.9, 0.2);   core_color = vec3(1.0, 1.0, 0.3);   // Well: yellow
    } else {
        aura_color = vec3(1.0, 0.3, 0.1);   core_color = vec3(1.0, 0.5, 0.2);   // Heat: red-orange
    }

    float pulse = 0.8 + 0.2 * sin(float(params.step) * 0.05 + float(fo_idx) * 1.57);

    for (int x = -range; x <= range; x++) {
        for (int y = -range; y <= range; y++) {
            ivec2 pixel = ivec2(floor(center)) + ivec2(x, y);
            if (pixel.x < 0 || pixel.x >= int(params.region_size.x)) continue;
            if (pixel.y < 0 || pixel.y >= int(params.region_size.y)) continue;

            float d = length(vec2(x, y));
            if (d > aura_radius) continue;

            vec4 existing = imageLoad(out_render_texture, pixel);

            if (d < core_radius) {
                // Solid core with inner glow
                float inner = 1.0 - d / core_radius;
                inner *= inner;
                vec3 col = mix(core_color * 0.8, vec3(1.0), inner * 0.5);
                // Edge smoothing
                float edge = 1.0 - smoothstep(core_radius * 0.65, core_radius, d);
                col *= edge;
                // Specular highlight
                vec2 hi_off = vec2(float(x) + core_radius * 0.25, float(y) + core_radius * 0.25);
                float hi_d = length(hi_off);
                if (hi_d < core_radius * 0.3) {
                    float hi = 1.0 - hi_d / (core_radius * 0.3);
                    col = mix(col, vec3(1.0), hi * hi * 0.5);
                }
                imageStore(out_render_texture, pixel, vec4(col, 1.0));
            } else {
                // Aura glow
                float t = (d - core_radius) / (aura_radius - core_radius);
                float glow = (1.0 - t) * (1.0 - t);
                vec3 glow_col = aura_color * glow * 0.4 * fo_str * pulse;
                imageStore(out_render_texture, pixel,
                    vec4(min(existing.rgb + glow_col, vec3(1.0)), 1.0));
            }
        }
    }
}

// ═══════════════════════════════════════════════════════════════════════════════
//  MIRROR RENDERING
// ═══════════════════════════════════════════════════════════════════════════════

void render_mirror(uint fo_idx) {
    vec2 m_a = vec2(force_objects.data[fo_idx].x, force_objects.data[fo_idx].y);
    vec2 m_b = vec2(force_objects.data[fo_idx]._pad0, force_objects.data[fo_idx]._pad1);

    vec2 screen_center = params.region_size * 0.5;
    vec2 sa = screen_center + (m_a - params.camera_origin) * params.camera_zoom;
    vec2 sb = screen_center + (m_b - params.camera_origin) * params.camera_zoom;

    float glow_radius = max(4.0, 2.0 * params.camera_zoom);

    vec2 lo = min(sa, sb) - glow_radius;
    vec2 hi = max(sa, sb) + glow_radius;
    lo = max(lo, vec2(0.0));
    hi = min(hi, params.region_size - 1.0);
    if (lo.x > hi.x || lo.y > hi.y) return;

    vec2 seg = sb - sa;
    float seg_len2 = dot(seg, seg);
    if (seg_len2 < 1.0) return;

    vec3 mirror_color = vec3(0.6, 0.65, 0.85);
    float pulse = 0.85 + 0.15 * sin(float(params.step) * 0.04 + float(fo_idx) * 2.1);
    float core_w = max(1.5, 0.8 * params.camera_zoom);

    for (int px = int(floor(lo.x)); px <= int(ceil(hi.x)); px++) {
        for (int py = int(floor(lo.y)); py <= int(ceil(hi.y)); py++) {
            vec2 p = vec2(float(px) + 0.5, float(py) + 0.5);

            float t = clamp(dot(p - sa, seg) / seg_len2, 0.0, 1.0);
            vec2 closest = sa + t * seg;
            float d = length(p - closest);

            if (d > glow_radius) continue;

            ivec2 pixel = ivec2(px, py);
            if (pixel.x < 0 || pixel.x >= int(params.region_size.x)) continue;
            if (pixel.y < 0 || pixel.y >= int(params.region_size.y)) continue;

            vec4 existing = imageLoad(out_render_texture, pixel);

            if (d < core_w) {
                float inner = 1.0 - d / core_w;
                vec3 col = mix(mirror_color * 0.9, vec3(1.0), inner * inner * 0.6) * pulse;
                imageStore(out_render_texture, pixel, vec4(max(existing.rgb, col), 1.0));
            } else {
                float glow_t = (d - core_w) / (glow_radius - core_w);
                float glow = (1.0 - glow_t) * (1.0 - glow_t);
                vec3 glow_col = mirror_color * glow * 0.25 * pulse;
                imageStore(out_render_texture, pixel,
                    vec4(min(existing.rgb + glow_col, vec3(1.0)), 1.0));
            }
        }
    }
}

// ═══════════════════════════════════════════════════════════════════════════════
//  WAVE PACKET RENDERING (de Broglie wave-particle duality)
// ═══════════════════════════════════════════════════════════════════════════════

void render_wave_packet(uint i) {
    vec2  pos    = in_pos_buffer.data[i];
    vec2  vel    = in_vel_buffer.data[i];
    uint  type   = type_buffer.data[i];
    float energy = in_energy_buffer.data[i];

    if (energy < 0.01) return;

    float mass_inv = get_mass_inv(type);
    float speed    = length(vel);
    float mass     = 1.0 / max(mass_inv, 0.0001);

    // de Broglie wavelength: λ ∝ 1/(m·v)
    // Visual scaling: heavier/faster → shorter wavelength, lighter/slower → longer
    float momentum = mass * max(speed, 0.5);
    float lambda   = clamp(60.0 / momentum, 3.0, 50.0) * params.camera_zoom;
    lambda = min(lambda, 60.0);  // Cap screen-space wavelength to prevent GPU timeout

    // Wave packet parameters
    float packet_half  = lambda * 2.0;           // ±2λ extent along velocity
    float sigma_long   = lambda * 1.2;           // Gaussian envelope spread (longitudinal)
    float sigma_trans  = lambda * 0.35;          // transverse spread
    float omega        = 6.28318 / lambda;       // spatial frequency

    // Direction (along velocity, or default if stationary)
    vec2 dir;
    if (speed > 0.1) {
        dir = vel / speed;
    } else {
        // Use pseudo-random direction for stationary particles
        float angle = float(i) * 2.399 + float(type) * 0.618;
        dir = vec2(cos(angle), sin(angle));
    }
    vec2 perp = vec2(-dir.y, dir.x);

    // Screen-space center
    vec2 screen_center = params.region_size * 0.5;
    vec2 center = screen_center + (pos - params.camera_origin) * params.camera_zoom;

    // Bounding box (elongated along velocity), capped for GPU safety
    int range_long  = int(ceil(packet_half));
    int range_trans = int(ceil(sigma_trans * 3.0));
    int range       = min(max(range_long, range_trans), 128);

    // Cull offscreen
    if (center.x + range < 0.0 || center.x - range > params.region_size.x) return;
    if (center.y + range < 0.0 || center.y - range > params.region_size.y) return;

    // Particle color
    vec4 base_col = color_buffer.data[type];
    base_col.rgb *= mix(0.3, 1.0, energy);

    // Time-dependent phase oscillation
    float phase_offset = float(params.step) * 0.15 * max(speed * 0.1, 1.0);

    // Precompute Gaussian denominators
    float inv_2sigma_l2 = 1.0 / (2.0 * sigma_long * sigma_long);
    float inv_2sigma_t2 = 1.0 / (2.0 * sigma_trans * sigma_trans);

    for (int x = -range; x <= range; x++) {
        for (int y = -range; y <= range; y++) {
            ivec2 pixel_pos = ivec2(floor(center)) + ivec2(x, y);
            vec2  px_center = vec2(pixel_pos) + 0.5;

            // Project onto wave packet local coordinates
            vec2 delta = px_center - center;
            float along  = dot(delta, dir);     // longitudinal (along velocity)
            float across = dot(delta, perp);    // transverse

            // Skip if too far from envelope
            if (abs(along) > packet_half || abs(across) > sigma_trans * 3.0) continue;

            // Gaussian envelope: |ψ|²
            float env = exp(-along * along * inv_2sigma_l2
                           - across * across * inv_2sigma_t2);

            if (env < 0.01) continue;

            // Oscillatory wave function: Re(ψ) = envelope × cos(k·x - ωt)
            float wave = cos(omega * along - phase_offset);

            // Display: probability density with visible wave crests
            // Blend between |ψ|² (probability) and visible oscillation
            float intensity = env * (0.4 + 0.6 * wave * wave);

            // Color: wave crests brighter, troughs dimmer, with particle color
            vec3 col = base_col.rgb * intensity * 1.4;

            // Bright central ridge along the wave axis
            float ridge = exp(-across * across * inv_2sigma_t2 * 3.0);
            col += base_col.rgb * ridge * env * wave * wave * 0.3;

            // Bounds check
            if (pixel_pos.x < 0 || pixel_pos.x >= int(params.region_size.x)) continue;
            if (pixel_pos.y < 0 || pixel_pos.y >= int(params.region_size.y)) continue;

            vec4 existing = imageLoad(out_render_texture, pixel_pos);
            imageStore(out_render_texture, pixel_pos,
                       vec4(min(existing.rgb + col, vec3(1.0)), 1.0));
        }
    }
}

// ═══════════════════════════════════════════════════════════════════════════════
//  RENDER STEP
// ═══════════════════════════════════════════════════════════════════════════════

void render_particle(uint i) {
    // Render force objects / mirrors (only first N threads)
    if (i < params.force_object_count && force_objects.data[i].is_active != 0u) {
        if (force_objects.data[i].force_type == 5u) {
            render_mirror(i);
        } else {
            render_force_object(i);
        }
    }

    // Wave mode: render as de Broglie wave packet instead of point particle
    if ((params.field_flags & (1u << 5)) != 0u) {
        render_wave_packet(i);
        return;
    }

    vec2  pos    = in_pos_buffer.data[i];
    uint  type   = type_buffer.data[i];
    float energy = in_energy_buffer.data[i];
    uint  flags  = behavior_buffer.data[type];

    if (energy < 0.01) return;

    // Hide virtual particles: negative decay marks virtual (sign convention from CPU)
    if ((params.field_flags & (1u << 7)) != 0u && get_decay(i) < -0.001) return;

    // Particle classification
    bool is_photon_p    = (flags & BEHAVIOR_PHOTON) != 0u;
    bool is_gluon_p     = (flags & BEHAVIOR_GLUON_FLAG) != 0u;
    bool is_neutrino_p  = (flags & BEHAVIOR_NEUTRINO) != 0u;
    bool is_nucleon     = (type <= NEUTRON_TYPE || type == ANTIPROTON_TYPE);
    bool is_lepton_p    = (flags & BEHAVIOR_LEPTON) != 0u;
    bool is_quark_p     = (flags & BEHAVIOR_QUARK) != 0u;
    bool is_antimatter  = (type == POSITRON_TYPE || type == ANTIPROTON_TYPE ||
                           type == ANTIMUON_TYPE || type == ANTITAU_TYPE ||
                           (type >= ANTI_UP && type <= ANTI_BOTTOM));
    bool is_boson_heavy = (flags & (BEHAVIOR_WEAK_BOSON | BEHAVIOR_HIGGS_FLAG)) != 0u;
    bool is_dark_matter = (flags & BEHAVIOR_DARK_MATTER) != 0u;
    bool is_dark_energy = (flags & BEHAVIOR_DARK_ENERGY) != 0u;
    bool is_virtual     = get_decay(i) < -0.001;  // negative decay = virtual particle

    // Size by particle type
    float base_radius = params.radius * params.camera_zoom;
    float render_radius;
    if (is_photon_p)        render_radius = base_radius * 0.25;      // massless: smaller than electron
    else if (is_gluon_p)    render_radius = base_radius * 0.3;       // colored boson: slightly larger than photon
    else if (is_neutrino_p) render_radius = base_radius * 0.2;       // nearly massless: smallest
    else if (is_dark_matter) render_radius = max(base_radius * 3.0, 4.0);  // diffuse halo
    else if (is_dark_energy) render_radius = max(base_radius * 5.0, 6.0);  // wide field
    else if (is_nucleon)    render_radius = base_radius * 0.7;
    else if (is_quark_p)    render_radius = base_radius * 0.45;
    else if (is_boson_heavy) render_radius = base_radius * 0.35;     // massive bosons: slightly smaller than electron
    else if (type == MUON_TYPE || type == ANTIMUON_TYPE) render_radius = base_radius * 0.5;
    else if (type == TAU_TYPE || type == ANTITAU_TYPE) render_radius = base_radius * 0.55;
    else                    render_radius = base_radius * 0.4;

    vec2 screen_center = params.region_size * 0.5;
    vec2 center = screen_center + (pos - params.camera_origin) * params.camera_zoom;

    float bloom = max(0.0, (energy - 0.5) * 2.0);
    float outer = render_radius * (1.0 + bloom * 0.6);
    int   range = int(ceil(outer));

    if (center.x + range < 0.0 || center.x - range > params.region_size.x) return;
    if (center.y + range < 0.0 || center.y - range > params.region_size.y) return;

    vec4 base_col = color_buffer.data[type];

    // Quarks: tint by color charge (R/G/B)
    if (is_quark_p) {
        float cc = get_color(i);
        float abs_cc = abs(cc);
        if (abs_cc > 0.5 && abs_cc < 1.5)       base_col.rgb = mix(base_col.rgb, vec3(1.0, 0.2, 0.2), 0.4); // R
        else if (abs_cc > 1.5 && abs_cc < 2.5)   base_col.rgb = mix(base_col.rgb, vec3(0.2, 1.0, 0.2), 0.4); // G
        else if (abs_cc > 2.5)                    base_col.rgb = mix(base_col.rgb, vec3(0.2, 0.2, 1.0), 0.4); // B
    }

    base_col.rgb *= mix(0.15, 1.0, energy);

    // Virtual particles flicker (use step + position hash for pseudo-random)
    if (is_virtual) {
        float flicker = 0.4 + 0.6 * fract(sin(float(i) * 12.9898 + float(params.step) * 0.7) * 43758.5453);
        base_col.rgb *= flicker;
        base_col.a *= 0.6;  // translucent
    }

    for (int x = -range; x <= range; x++) {
        for (int y = -range; y <= range; y++) {
            ivec2 pixel_pos = ivec2(floor(center)) + ivec2(x, y);
            vec2  px_center = vec2(pixel_pos) + 0.5;
            float d = distance(px_center, center);

            if (d >= outer) continue;

            vec4 col = base_col;

            if (d < render_radius) {
                // ── Photon: radial glow ──────────────────────────────────────
                if (is_photon_p) {
                    float norm_d = d / render_radius;
                    float glow = max(0.0, 1.0 - norm_d * norm_d);
                    col.rgb *= glow * 1.6;
                    vec4 existing = imageLoad(out_render_texture, pixel_pos);
                    imageStore(out_render_texture, pixel_pos,
                               vec4(min(existing.rgb + col.rgb, vec3(1.0)), 1.0));
                    continue;
                }

                // ── Gluon: colored radial glow with color charge accent ─────
                if (is_gluon_p) {
                    float norm_d = d / render_radius;
                    float glow = max(0.0, 1.0 - norm_d * norm_d);
                    // Base green tint (gluon identity)
                    col.rgb = mix(col.rgb, vec3(0.3, 1.0, 0.3), 0.4);
                    // Accent by carried color (R/G/B)
                    float gc = gluon_carried(get_color(i));
                    if (abs(gc - 1.0) < 0.1)      col.rgb = mix(col.rgb, vec3(1.0, 0.3, 0.3), 0.25);
                    else if (abs(gc - 2.0) < 0.1)  col.rgb = mix(col.rgb, vec3(0.3, 1.0, 0.3), 0.25);
                    else if (abs(gc - 3.0) < 0.1)  col.rgb = mix(col.rgb, vec3(0.3, 0.3, 1.0), 0.25);
                    col.rgb *= glow * 1.4;
                    vec4 existing = imageLoad(out_render_texture, pixel_pos);
                    imageStore(out_render_texture, pixel_pos,
                               vec4(min(existing.rgb + col.rgb, vec3(1.0)), 1.0));
                    continue;
                }

                // ── Neutrino: faint ghostly glow ────────────────────────────
                if (is_neutrino_p) {
                    float norm_d = d / render_radius;
                    float glow = max(0.0, 1.0 - norm_d * norm_d);
                    col.rgb *= glow * 0.6;
                    col.rgb = mix(col.rgb, vec3(0.7, 1.0, 0.7), 0.3);
                    vec4 existing = imageLoad(out_render_texture, pixel_pos);
                    imageStore(out_render_texture, pixel_pos,
                               vec4(min(existing.rgb + col.rgb, vec3(1.0)), 1.0));
                    continue;
                }

                // ── Heavy bosons (W/Z/Higgs): bright flash ──────────────────
                if (is_boson_heavy) {
                    float norm_d = d / render_radius;
                    float glow = max(0.0, 1.0 - norm_d * norm_d);
                    if (type == HIGGS_TYPE) {
                        col.rgb = mix(col.rgb, vec3(1.0, 0.95, 0.7), glow * 0.6);
                    } else {
                        col.rgb = mix(col.rgb, vec3(0.8, 0.9, 1.0), glow * 0.7);
                    }
                    col.rgb *= glow * 2.0;
                    vec4 existing = imageLoad(out_render_texture, pixel_pos);
                    imageStore(out_render_texture, pixel_pos,
                               vec4(min(existing.rgb + col.rgb, vec3(1.0)), 1.0));
                    continue;
                }

                // ── Dark matter: diffuse purple halo ─────────────────────────
                if (is_dark_matter) {
                    float norm_d = d / render_radius;
                    float glow = max(0.0, 1.0 - norm_d * norm_d) * 0.4;
                    col.rgb *= glow;
                    vec4 existing = imageLoad(out_render_texture, pixel_pos);
                    imageStore(out_render_texture, pixel_pos,
                               vec4(min(existing.rgb + col.rgb, vec3(1.0)), 1.0));
                    continue;
                }

                // ── Dark energy: wide faint field ────────────────────────────
                if (is_dark_energy) {
                    float norm_d = d / render_radius;
                    float glow = max(0.0, 1.0 - norm_d) * 0.25;
                    col.rgb *= glow;
                    vec4 existing = imageLoad(out_render_texture, pixel_pos);
                    imageStore(out_render_texture, pixel_pos,
                               vec4(min(existing.rgb + col.rgb, vec3(1.0)), 1.0));
                    continue;
                }

                // ── Smooth edge for solid particles ─────────────────────────
                float edge = 1.0 - smoothstep(render_radius * 0.65, render_radius, d);
                col.rgb *= edge;

                // ── Nucleon inner glow ──────────────────────────────────────
                if (is_nucleon) {
                    float inner_glow = 1.0 - d / render_radius;
                    inner_glow *= inner_glow;
                    if (type == PROTON_TYPE) {
                        col.rgb = mix(col.rgb, vec3(1.0, 0.4, 0.1), inner_glow * 0.4);
                    } else if (type == ANTIPROTON_TYPE) {
                        col.rgb = mix(col.rgb, vec3(0.4, 1.0, 0.9), inner_glow * 0.5);
                    } else {
                        col.rgb = mix(col.rgb, vec3(0.9, 0.9, 1.0), inner_glow * 0.3);
                    }
                }

                // ── Quark inner glow (color-charge tinted) ──────────────────
                if (is_quark_p) {
                    float inner_glow = 1.0 - d / render_radius;
                    inner_glow *= inner_glow;
                    col.rgb = mix(col.rgb, vec3(1.0, 1.0, 1.0), inner_glow * 0.35);
                }

                // ── Antimatter halo ring ────────────────────────────────────
                if (is_antimatter) {
                    float ring_d = abs(d - render_radius * 0.75);
                    float ring = exp(-ring_d * ring_d / (render_radius * 0.06 + 0.01));
                    col.rgb = mix(col.rgb, vec3(1.0), ring * 0.35);
                }

                // ── Specular highlight ──────────────────────────────────────
                vec2  hi_ctr = center + vec2(-render_radius * 0.25, -render_radius * 0.25);
                float d_hi   = distance(px_center, hi_ctr);
                if (d_hi < render_radius * 0.30) {
                    float hi = 1.0 - d_hi / (render_radius * 0.30);
                    hi *= hi;
                    col.rgb = mix(col.rgb, vec3(1.0), hi * 0.45);
                }

                imageStore(out_render_texture, pixel_pos, col);

            } else if (!is_photon_p && bloom > 0.01) {
                float t    = (d - render_radius) / (outer - render_radius);
                float glow = (1.0 - t) * (1.0 - t) * bloom * 0.3;
                vec4 existing = imageLoad(out_render_texture, pixel_pos);
                imageStore(out_render_texture, pixel_pos,
                           vec4(min(existing.rgb + col.rgb * glow, vec3(1.0)), 1.0));
            }
        }
    }

    // ── Bond line rendering (only lower-index draws to avoid double-draw) ────
    if ((params.field_flags & (1u << 8)) != 0u) return;  // hide bond visuals
    for (uint s = 0u; s < 6u; s++) {
        uint partner = bond_buffer.data[i * 6u + s];
        if (partner == 0xFFFFFFFFu || partner >= params.particle_count) continue;
        if (i > partner) continue;  // lower index renders the line

        vec2 screen_ctr = params.region_size * 0.5;
        vec2 sa = screen_ctr + (pos - params.camera_origin) * params.camera_zoom;
        vec2 partner_pos = in_pos_buffer.data[partner];
        vec2 sb = screen_ctr + (partner_pos - params.camera_origin) * params.camera_zoom;

        float glow_w = max(2.5, 1.2 * params.camera_zoom);
        vec2 lo = min(sa, sb) - glow_w;
        vec2 hi = max(sa, sb) + glow_w;
        lo = max(lo, vec2(0.0));
        hi = min(hi, params.region_size - 1.0);
        if (lo.x > hi.x || lo.y > hi.y) continue;

        vec2 seg = sb - sa;
        float seg_len2 = dot(seg, seg);
        if (seg_len2 < 1.0) continue;

        // Bond color: pale blue with energy-based brightness
        float e_avg = (energy + in_energy_buffer.data[partner]) * 0.5;
        vec3 bond_col = mix(vec3(0.3, 0.5, 0.8), vec3(0.6, 0.85, 1.0), clamp(e_avg * 2.0, 0.0, 1.0));
        float core_w = max(0.8, 0.4 * params.camera_zoom);

        for (int px = int(floor(lo.x)); px <= int(ceil(hi.x)); px++) {
            for (int py = int(floor(lo.y)); py <= int(ceil(hi.y)); py++) {
                vec2 p = vec2(float(px) + 0.5, float(py) + 0.5);
                float t = clamp(dot(p - sa, seg) / seg_len2, 0.0, 1.0);
                vec2 closest = sa + t * seg;
                float d = length(p - closest);
                if (d > glow_w) continue;

                ivec2 pixel = ivec2(px, py);
                if (pixel.x < 0 || pixel.x >= int(params.region_size.x)) continue;
                if (pixel.y < 0 || pixel.y >= int(params.region_size.y)) continue;

                vec4 existing = imageLoad(out_render_texture, pixel);
                float alpha;
                if (d < core_w) {
                    alpha = 0.7;
                } else {
                    float gt = (d - core_w) / (glow_w - core_w);
                    alpha = (1.0 - gt) * (1.0 - gt) * 0.35;
                }
                imageStore(out_render_texture, pixel,
                    vec4(min(existing.rgb + bond_col * alpha, vec3(1.0)), 1.0));
            }
        }
    }

}

// ═══════════════════════════════════════════════════════════════════════════════
//  FIELD VISUALIZATION (step 2)
// ═══════════════════════════════════════════════════════════════════════════════

const float FIELD_MAX_WORLD_RADIUS = 60.0;
const float FIELD_MAX_SCREEN_RADIUS = 60.0;
const float FIELD_SCALE = 0.00025;

// ── Force object field visualization ─────────────────────────────────────────
// Renders force object contributions to the field overlay so they appear
// alongside particle fields when the corresponding visualization is enabled.
void render_force_object_field(uint fo_idx, uint fflags) {
    if (force_objects.data[fo_idx].is_active == 0u) return;
    uint  fo_type   = force_objects.data[fo_idx].force_type;
    float fo_str    = force_objects.data[fo_idx].strength;
    float fo_radius = force_objects.data[fo_idx].radius;
    vec2  fo_pos    = vec2(force_objects.data[fo_idx].x, force_objects.data[fo_idx].y);
    if (fo_type == 5u) return;  // mirror — no field

    // Determine which field flags this force object contributes to
    bool show_em     = (fflags & 1u) != 0u;
    bool show_strong = (fflags & 2u) != 0u;
    bool show_weak   = (fflags & 4u) != 0u;
    bool show_grav   = (fflags & 8u) != 0u;

    // Only render if the corresponding field visualization is enabled
    bool contributes = false;
    if (show_em     && (fo_type == 0u || fo_type == 6u)) contributes = true;
    if (show_strong && fo_type == 1u) contributes = true;
    if (show_weak   && fo_type == 2u) contributes = true;
    if (show_grav   && (fo_type == 3u || fo_type == 8u)) contributes = true;
    if (!contributes) return;

    float intensity = params.local_density_cap;
    float scale = FIELD_SCALE * intensity * 4.0;  // force objects are brighter sources

    vec2 screen_center = params.region_size * 0.5;
    vec2 center = screen_center + (fo_pos - params.camera_origin) * params.camera_zoom;

    float screen_range = min(fo_radius * params.camera_zoom, FIELD_MAX_SCREEN_RADIUS * 2.0);
    int range = int(ceil(screen_range));

    if (center.x + float(range) < 0.0 || center.x - float(range) > params.region_size.x) return;
    if (center.y + float(range) < 0.0 || center.y - float(range) > params.region_size.y) return;

    for (int x = -range; x <= range; x++) {
        for (int y = -range; y <= range; y++) {
            ivec2 pixel = ivec2(floor(center)) + ivec2(x, y);
            if (pixel.x < 0 || pixel.x >= int(params.region_size.x)) continue;
            if (pixel.y < 0 || pixel.y >= int(params.region_size.y)) continue;

            float screen_dist = length(vec2(x, y));
            if (screen_dist > screen_range) continue;

            float world_dist = max(screen_dist / params.camera_zoom, 1.0);
            float fo_t = world_dist / fo_radius;
            if (fo_t > 1.0) continue;

            vec3 field_color = vec3(0.0);

            if (fo_type == 0u && show_em) {
                // EM field: Coulomb potential pattern (red positive / blue negative)
                float phi = fo_str / (world_dist * world_dist + 4.0);
                float viz_K = 12000.0;
                if (phi > 0.0)
                    field_color += vec3(phi * 1.0, phi * 0.25, phi * 0.03) * viz_K;
                else
                    field_color += vec3(-phi * 0.03, -phi * 0.35, -phi * 1.0) * viz_K;
            }
            else if (fo_type == 6u && show_em) {
                // Coulomb source: same Coulomb pattern, stronger point-charge look
                float phi = fo_str / (world_dist * world_dist + 2.0);
                float viz_K = 15000.0;
                if (phi > 0.0)
                    field_color += vec3(phi * 1.0, phi * 0.25, phi * 0.03) * viz_K;
                else
                    field_color += vec3(-phi * 0.03, -phi * 0.35, -phi * 1.0) * viz_K;
            }
            else if (fo_type == 1u && show_strong) {
                // Strong: Yukawa potential
                float yukawa = exp(-world_dist / (YUKAWA_RANGE * 3.0)) / max(world_dist, 0.5);
                field_color += vec3(yukawa * 0.08, yukawa * 0.6, yukawa * 0.35)
                             * YUKAWA_COUPLING * abs(fo_str) * 3.0;
            }
            else if (fo_type == 2u && show_weak) {
                // Weak: short-range exponential
                float weak_V = abs(fo_str) * exp(-world_dist / 5.0);
                field_color += vec3(weak_V * 0.5, weak_V * 0.1, weak_V * 0.9) * 1200.0;
            }
            else if (fo_type == 3u && show_grav) {
                // Gravity well: 1/r² potential
                float grav_phi = abs(fo_str) / (world_dist * world_dist + 4.0);
                field_color += vec3(grav_phi * 0.2, grav_phi * 0.25, grav_phi * 0.5) * 800.0;
            }
            else if (fo_type == 8u && show_grav) {
                // Potential well: harmonic potential (shows under gravity viz)
                float harm_phi = abs(fo_str) * world_dist / fo_radius;
                float falloff = 1.0 - fo_t;
                field_color += vec3(harm_phi * 0.3, harm_phi * 0.3, harm_phi * 0.1)
                             * falloff * 400.0;
            }

            field_color *= scale;

            vec4 existing = imageLoad(out_render_texture, pixel);
            imageStore(out_render_texture, pixel,
                       vec4(min(existing.rgb + field_color, vec3(1.0)), 1.0));
        }
    }
}

void render_field(uint i) {
    // Render force object fields (first N threads handle force objects)
    if (i < params.force_object_count) {
        uint fo_fflags = params.field_flags;
        if (fo_fflags == 0u) {
            float fm = params.density_limit;
            if (fm > 0.5 && fm < 1.5) fo_fflags = 1u;
            else if (fm > 1.5 && fm < 2.5) fo_fflags = 2u;
            else if (fm > 2.5 && fm < 3.5) fo_fflags = 3u;
        }
        if (fo_fflags != 0u)
            render_force_object_field(i, fo_fflags);
    }

    vec2  pos    = in_pos_buffer.data[i];
    uint  type   = type_buffer.data[i];
    float energy = in_energy_buffer.data[i];
    uint  flags  = behavior_buffer.data[type];

    if (energy < 0.01) return;

    // Skip photons and neutrinos from field rendering
    if ((flags & (BEHAVIOR_PHOTON | BEHAVIOR_NEUTRINO)) != 0u) return;

    uint fflags = params.field_flags;
    // Support legacy density_limit encoding for backward compat
    if (fflags == 0u) {
        float fm = params.density_limit;
        if (fm > 0.5 && fm < 1.5) fflags = 1u;
        else if (fm > 1.5 && fm < 2.5) fflags = 2u;
        else if (fm > 2.5 && fm < 3.5) fflags = 3u;
    }

    bool show_em     = (fflags & 1u) != 0u;
    bool show_strong = (fflags & 2u) != 0u;
    bool show_weak   = (fflags & 4u) != 0u;
    bool show_grav   = (fflags & 8u) != 0u;
    bool show_higgs  = (fflags & 16u) != 0u;
    bool show_de     = (fflags & (1u << 12)) != 0u;

    float charge     = get_charge(i);
    bool has_charge  = abs(charge) > 0.01;
    bool is_nucleon  = is_baryon(type);
    bool is_colored_p = is_colored(flags);
    bool is_weak_b   = (flags & BEHAVIOR_WEAK_BOSON) != 0u;
    bool is_massive  = get_mass_inv(type) < 10.0;
    bool is_de       = (flags & BEHAVIOR_DARK_ENERGY) != 0u;

    float intensity  = params.local_density_cap;

    // Check if this particle contributes to any enabled field
    bool contributes = false;
    if (show_em && has_charge) contributes = true;
    if (show_strong && (is_nucleon || is_colored_p)) contributes = true;
    if (show_weak && (is_weak_b || is_massive)) contributes = true;  // all massive feel weak
    if (show_grav && is_massive) contributes = true;
    if (show_higgs && is_massive) contributes = true;
    if (show_de && is_de) contributes = true;
    if (!contributes) return;

    vec2 screen_center = params.region_size * 0.5;
    vec2 center = screen_center + (pos - params.camera_origin) * params.camera_zoom;

    float world_range = 0.0;
    if (show_em && has_charge) world_range = FIELD_MAX_WORLD_RADIUS;
    if (show_strong && (is_nucleon || is_colored_p)) world_range = max(world_range, YUKAWA_RANGE * 3.5);
    if (show_weak && (is_weak_b || is_massive)) world_range = max(world_range, 15.0);
    if (show_grav && is_massive) world_range = max(world_range, FIELD_MAX_WORLD_RADIUS);
    if (show_higgs && is_massive) world_range = max(world_range, 40.0);
    if (show_de && is_de) world_range = max(world_range, FIELD_MAX_WORLD_RADIUS);

    float screen_range = min(world_range * params.camera_zoom, FIELD_MAX_SCREEN_RADIUS);
    int range = int(ceil(screen_range));

    if (center.x + float(range) < 0.0 || center.x - float(range) > params.region_size.x) return;
    if (center.y + float(range) < 0.0 || center.y - float(range) > params.region_size.y) return;

    float scale = FIELD_SCALE * intensity * energy;

    for (int x = -range; x <= range; x++) {
        for (int y = -range; y <= range; y++) {
            ivec2 pixel = ivec2(floor(center)) + ivec2(x, y);
            if (pixel.x < 0 || pixel.x >= int(params.region_size.x)) continue;
            if (pixel.y < 0 || pixel.y >= int(params.region_size.y)) continue;

            float screen_dist = length(vec2(x, y));
            if (screen_dist > screen_range) continue;

            float world_dist = max(screen_dist / params.camera_zoom, 1.0);

            vec3 field_color = vec3(0.0);

            // ── Electromagnetic (Coulomb potential) ──────────────────────
            if (show_em && has_charge) {
                float phi = charge / (world_dist * world_dist + 9.0);
                float viz_K = 8000.0;  // visualization brightness (independent of physics K)
                if (phi > 0.0)
                    field_color += vec3(phi * 1.0, phi * 0.25, phi * 0.03) * viz_K;
                else
                    field_color += vec3(-phi * 0.03, -phi * 0.35, -phi * 1.0) * viz_K;
            }

            // ── Strong nuclear (Yukawa for nucleons, color for quarks) ──
            if (show_strong) {
                if (is_nucleon) {
                    float yukawa = exp(-world_dist / YUKAWA_RANGE) / max(world_dist, 0.5);
                    field_color += vec3(yukawa * 0.08, yukawa * 0.6, yukawa * 0.35) * YUKAWA_COUPLING;
                }
                if (is_colored_p) {
                    float cc = abs(get_color(i));
                    float cornell = params.string_tension * world_dist * 0.001;
                    vec3 qcd_col = vec3(0.0);
                    if (cc > 0.5 && cc < 1.5) qcd_col = vec3(cornell, 0.0, 0.0);         // R
                    else if (cc > 1.5 && cc < 2.5) qcd_col = vec3(0.0, cornell, 0.0);     // G
                    else qcd_col = vec3(0.0, 0.0, cornell);                                 // B
                    field_color += qcd_col * 2.0;
                }
            }

            // ── Weak field (short range, all massive particles participate) ─
            if (show_weak && (is_weak_b || is_massive)) {
                float weak_range = is_weak_b ? 0.8 : 3.0;  // W/Z tighter, fermions broader
                float weak_str = is_weak_b ? 3.0 : 0.8;    // W/Z brighter
                float weak_V = weak_str * exp(-world_dist / weak_range);
                field_color += vec3(weak_V * 0.5, weak_V * 0.1, weak_V * 0.9) * 800.0;
            }

            // ── Gravitational ───────────────────────────────────────────
            if (show_grav && is_massive) {
                float mass = get_mass(type);
                float grav_phi = mass / (world_dist * world_dist + 4.0);
                field_color += vec3(grav_phi * 0.2, grav_phi * 0.25, grav_phi * 0.5) * 500.0;
            }

            // ── Higgs field (Yukawa coupling — massive particles source it) ─
            if (show_higgs && is_massive) {
                float mass = get_mass(type);
                float higgs_d = mass * exp(-world_dist / 30.0) / (world_dist + 1.0);
                field_color += vec3(higgs_d * 0.7, higgs_d * 0.6, higgs_d * 0.15) * 400.0;
            }

            // ── Dark Energy (repulsive — grows with distance, Lambda-CDM) ────
            if (show_de && is_de) {
                float lambda_eff = 0.8 / (params.interaction_radius + 1.0);
                // DE field strength grows linearly with distance (cosmological expansion)
                float de_phi = lambda_eff * world_dist / (world_dist + 2.0);
                // Inflaton: 20x stronger (inflationary epoch)
                if (type == INFLATON_TYPE) de_phi *= 20.0;
                // Chameleon: screened at short range (thin-shell mechanism)
                if (type == CHAMELEON_TYPE) {
                    float screen = world_dist / (world_dist + 8.0);
                    de_phi *= screen;
                }
                // Crimson-red glow — repulsive field expanding outward
                field_color += vec3(de_phi * 0.9, de_phi * 0.12, de_phi * 0.18) * 3000.0;
            }

            field_color *= scale;

            vec4 existing = imageLoad(out_render_texture, pixel);
            imageStore(out_render_texture, pixel,
                       vec4(min(existing.rgb + field_color, vec3(1.0)), 1.0));
        }
    }
}

// ═══════════════════════════════════════════════════════════════════════════════
//  ENTRY POINT
// ═══════════════════════════════════════════════════════════════════════════════

// ── Trail fade pass (step=3): per-pixel darken toward background ─────────────
void fade_pixel(uint pixel_idx) {
    uint tex_w = uint(params.region_size.x);
    uint tex_h = uint(params.region_size.y);
    if (pixel_idx >= tex_w * tex_h) return;

    ivec2 px = ivec2(pixel_idx % tex_w, pixel_idx / tex_w);
    vec4 existing = imageLoad(out_render_texture, px);
    vec3 bg = vec3(0.01, 0.01, 0.04);
    existing.rgb = mix(bg, existing.rgb, 0.93);
    imageStore(out_render_texture, px, existing);
}

// ═══════════════════════════════════════════════════════════════════════════════
//  COLLISION DEBUG OVERLAY (step 4) — runs AFTER all particles are rendered
// ═══════════════════════════════════════════════════════════════════════════════

void render_collision_debug(uint i) {
    vec2  pos    = in_pos_buffer.data[i];
    uint  type   = type_buffer.data[i];
    float energy = in_energy_buffer.data[i];

    if (energy < 0.01) return;

    bool is_nuc = is_baryon(type);

    vec2 screen_center = params.region_size * 0.5;
    vec2 center = screen_center + (pos - params.camera_origin) * params.camera_zoom;

    // ── Collision radii (world-space px, same as physics code) ───────────
    float r_hard = is_nuc ? PAULI_CORE * 0.25 : params.radius * 2.0;
    float r_repulsion = params.repulsion_radius;

    // Outermost ring determines pixel scan area
    float max_r = max(r_hard, r_repulsion);
    if (is_nuc) max_r = max(max_r, YUKAWA_RANGE);
    float screen_max = max_r * params.camera_zoom;
    int ring_range = int(ceil(screen_max)) + 2;

    // Frustum cull
    if (center.x + float(ring_range) < 0.0 || center.x - float(ring_range) > params.region_size.x) return;
    if (center.y + float(ring_range) < 0.0 || center.y - float(ring_range) > params.region_size.y) return;

    float thickness = max(1.2, params.camera_zoom * 0.4);

    for (int x = -ring_range; x <= ring_range; x++) {
        for (int y = -ring_range; y <= ring_range; y++) {
            ivec2 px = ivec2(floor(center)) + ivec2(x, y);
            if (px.x < 0 || px.x >= int(params.region_size.x)) continue;
            if (px.y < 0 || px.y >= int(params.region_size.y)) continue;

            float d_screen = distance(vec2(px) + 0.5, center);
            vec3 ring_col = vec3(0.0);

            // Hard-sphere ring (green) — actual collision boundary
            float r_hard_s = r_hard * params.camera_zoom;
            if (abs(d_screen - r_hard_s) < thickness)
                ring_col = vec3(0.0, 1.0, 0.0);

            // Soft-body repulsion ring (cyan)
            float r_rep_s = r_repulsion * params.camera_zoom;
            if (abs(d_screen - r_rep_s) < thickness)
                ring_col = max(ring_col, vec3(0.0, 0.8, 0.8));

            if (is_nuc) {
                // Pauli core ring (yellow) — smooth repulsion zone
                float r_pauli_s = PAULI_CORE * params.camera_zoom;
                if (abs(d_screen - r_pauli_s) < thickness)
                    ring_col = max(ring_col, vec3(1.0, 1.0, 0.0));

                // Yukawa range ring (red) — nuclear force cutoff
                float r_yukawa_s = YUKAWA_RANGE * params.camera_zoom;
                if (abs(d_screen - r_yukawa_s) < thickness)
                    ring_col = max(ring_col, vec3(1.0, 0.0, 0.0));
            }

            if (dot(ring_col, ring_col) > 0.001) {
                vec4 existing = imageLoad(out_render_texture, px);
                imageStore(out_render_texture, px,
                           vec4(min(existing.rgb + ring_col * 0.9, vec3(1.0)), 1.0));
            }
        }
    }
}

void main() {
    uint i = gl_GlobalInvocationID.x;

    // Step 3 (trail fade) uses pixel index, not particle index
    if (params.step == 3u) {
        fade_pixel(i);
        return;
    }

    if (i >= params.particle_count) return;

    switch (params.step) {
        case 0: apply_physics(i);    break;
        case 1: render_particle(i);  break;
        case 2: render_field(i);     break;
        case 4: render_collision_debug(i); break;
    }
}
