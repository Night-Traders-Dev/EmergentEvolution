#version 450

layout(local_size_x = 256) in;

// ── Buffer layout (same as chemistry shader — reuses ComputePipeline) ────────
layout(set = 0, binding = 0, std430) buffer InPosBuffer  { vec2  data[]; } in_pos_buffer;
layout(set = 0, binding = 1, std430) buffer InVelBuffer  { vec2  data[]; } in_vel_buffer;
layout(set = 0, binding = 2, std430) readonly buffer Types  { uint  data[]; } type_buffer;
layout(set = 0, binding = 3, std430) buffer Forces       { float data[]; } force_buffer;
layout(set = 0, binding = 4, std430) buffer Colors       { vec4  data[]; } color_buffer;
layout(set = 0, binding = 5, std430) buffer OutPosBuffer { vec2  data[]; } out_pos_buffer;
layout(set = 0, binding = 6, std430) buffer OutVelBuffer { vec2  data[]; } out_vel_buffer;
layout(set = 0, binding = 7, rgba32f) uniform image2D out_render_texture;
layout(set = 0, binding =  8, std430) readonly buffer Behaviors { uint  data[]; } behavior_buffer;
layout(set = 0, binding =  9, std430) buffer AngleIn            { float data[]; } angle_in_buffer;
layout(set = 0, binding = 10, std430) buffer AngVelIn           { float data[]; } avel_in_buffer;
layout(set = 0, binding = 11, std430) buffer AngleOut           { float data[]; } angle_out_buffer;
layout(set = 0, binding = 12, std430) buffer AngVelOut          { float data[]; } avel_out_buffer;
layout(set = 0, binding = 13, std430) buffer EnergyIn  { float data[]; } in_energy_buffer;
layout(set = 0, binding = 14, std430) buffer EnergyOut { float data[]; } out_energy_buffer;
layout(set = 0, binding = 15, std430) readonly buffer Genomes { float data[]; } genome_buffer;
layout(set = 0, binding = 16, std430) readonly buffer BondBuffer { uint data[]; } bond_buffer;

// Force objects (stationary emitters, max 8)
struct ForceObj {
    float x, y;
    float strength;
    float radius;
    uint  force_type;
    uint  is_active;
    float _pad0;
    float _pad1;
};
layout(set = 0, binding = 17, std430) readonly buffer ForceObjectBuffer {
    ForceObj data[];
} force_objects;

// Per-type mass_inv + ZPE lookup (CPU-populated, replaces branching if-chains)
// Layout: [type*2+0] = mass_inv, [type*2+1] = zpe
layout(set = 0, binding = 18, std430) readonly buffer MassZpeBuffer {
    float data[];
} mass_zpe_buffer;

// GPU spatial grid (CPU-built prefix-sum, uploaded each frame)
layout(set = 0, binding = 19, std430) readonly buffer GridCellStart { uint data[]; } grid_cell_start;
layout(set = 0, binding = 20, std430) readonly buffer GridIndices   { uint data[]; } grid_indices;

// Grid constants (world 10240×5760, cell size 100px)
const float GRID_CELL_SIZE = 100.0;
const int   GRID_COLS      = 103;  // ceil(10240/100)
const int   GRID_ROWS      = 58;   // ceil(5760/100)

// ── Push Constants (expanded to 100 bytes) ──────────────────────────────────
layout(push_constant, std430) uniform Params {
    vec2  region_size;
    vec2  camera_origin;
    uint  particle_count;
    uint  particle_types;
    uint  step;
    float dt;
    float camera_zoom;
    float radius;
    float dampening;
    float repulsion_radius;
    float interaction_radius;
    float density_limit;
    float viscosity_strength;
    float pressure_resistance;
    float local_density_cap;
    float temperature;
    float gravity_strength;
    float lorentz_strength;
    float vacuum_energy;
    uint  field_flags;
    float weak_coupling;
    float string_tension;
    float higgs_vev;
    uint  force_object_count;
    // Per-force multipliers (all 1.0 = standard model strengths)
    float coulomb_strength;
    float yukawa_strength;
    float pauli_multiplier;
    float alpha_s_scale;
    float compton_strength;
    float annihilation_strength;
} params;

