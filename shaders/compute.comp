#version 450

layout(local_size_x = 256) in;

// ── Input Buffers ────────────────────────────────────────────────────────────
layout(set = 0, binding = 0, std430) buffer InPosBuffer  { vec2  data[]; } in_pos_buffer;
layout(set = 0, binding = 1, std430) buffer InVelBuffer  { vec2  data[]; } in_vel_buffer;
layout(set = 0, binding = 2, std430) buffer Types        { uint  data[]; } type_buffer;
layout(set = 0, binding = 3, std430) buffer Forces       { float data[]; } force_buffer;
layout(set = 0, binding = 4, std430) buffer Colors       { vec4  data[]; } color_buffer;

// ── Output Buffers ───────────────────────────────────────────────────────────
layout(set = 0, binding = 5, std430) buffer OutPosBuffer { vec2  data[]; } out_pos_buffer;
layout(set = 0, binding = 6, std430) buffer OutVelBuffer { vec2  data[]; } out_vel_buffer;
layout(set = 0, binding = 7, rgba32f) uniform image2D out_render_texture;

// ── Behavior / Orientation Buffers ───────────────────────────────────────────
layout(set = 0, binding =  8, std430) readonly buffer Behaviors { uint  data[]; } behavior_buffer;
layout(set = 0, binding =  9, std430) buffer AngleIn            { float data[]; } angle_in_buffer;
layout(set = 0, binding = 10, std430) buffer AngVelIn           { float data[]; } avel_in_buffer;
layout(set = 0, binding = 11, std430) buffer AngleOut           { float data[]; } angle_out_buffer;
layout(set = 0, binding = 12, std430) buffer AngVelOut          { float data[]; } avel_out_buffer;
layout(set = 0, binding = 13, std430) buffer EnergyIn           { float data[]; } energy_in_buffer;
layout(set = 0, binding = 14, std430) buffer EnergyOut          { float data[]; } energy_out_buffer;

// ── Push Constants ────────────────────────────────────────────────────────────
layout(push_constant, std430) uniform Params {
    vec2  region_size;
    vec2  camera_origin;
    uint  particle_count;
    uint  particle_types;
    uint  step;
    float dt;
    float camera_zoom;
    float radius;
    float dampening;
    float repulsion_radius;
    float interaction_radius;
    float density_limit;
    float viscosity_strength;
    float pressure_resistance;
    float local_density_cap;
    float metabolic_rate;     // passive drain
    float energy_gain_rate;   // feeding gain
} params;

const uint BEHAVIOR_REPEL    = 1u;
const uint BEHAVIOR_POLAR    = 2u;
const uint BEHAVIOR_HEAVY    = 4u;
const uint BEHAVIOR_CATALYST = 8u;
const uint BEHAVIOR_VIRAL    = 16u;

void apply_physics(uint i) {
    const float MAX_RADIUS = params.interaction_radius;
    const float MAX_RADIUS_SQ = MAX_RADIUS * MAX_RADIUS;

    vec2  pos_a         = in_pos_buffer.data[i];
    vec2  vel_a         = in_vel_buffer.data[i];
    uint  type_a        = type_buffer.data[i];
    float current_energy = energy_in_buffer.data[i];

    // Dead particles drift
    if (type_a == 0) {
        vec2 friction_vel = vel_a * 0.95f;
        out_vel_buffer.data[i] = friction_vel;
        out_pos_buffer.data[i] = pos_a + friction_vel * params.dt;
        energy_out_buffer.data[i] = 0.0f;
        return;
    }

    uint  flags_a = behavior_buffer.data[type_a];
    vec2  total_force = vec2(0.0f);
    float local_density = 0.0f;
    float feeding_gain = 0.0f;

    // ─────────────────────────────────────────────
    // Interaction Loop
    // ─────────────────────────────────────────────
    for (uint j = 0; j < params.particle_count; j++) {
        if (i == j) continue;

        vec2 pos_b = in_pos_buffer.data[j];
        uint type_b = type_buffer.data[j];
        vec2 delta = pos_b - pos_a;

        // Toroidal wrap
        if (delta.x >  params.region_size.x * 0.5f) delta.x -= params.region_size.x;
        if (delta.x < -params.region_size.x * 0.5f) delta.x += params.region_size.x;
        if (delta.y >  params.region_size.y * 0.5f) delta.y -= params.region_size.y;
        if (delta.y < -params.region_size.y * 0.5f) delta.y += params.region_size.y;

        float dist_sq = dot(delta, delta);
        if (dist_sq > MAX_RADIUS_SQ || dist_sq < 0.0001f) continue;

        float dist = sqrt(dist_sq);
        vec2  dir  = delta / dist;

        // Attraction / Repulsion
        float force_mag = 0.0f;
        if (dist < params.repulsion_radius) {
            force_mag = (dist / params.repulsion_radius - 1.0f);
        } else {
            float strength = force_buffer.data[type_a + type_b * params.particle_types];
            float interact_dist = params.interaction_radius - params.repulsion_radius;
            force_mag = strength * (1.0f - abs(2.0f * (dist - params.repulsion_radius) / interact_dist - 1.0f));
        }

        total_force += dir * force_mag;
        local_density += 1.0f;

        // ─────────────────────────────────────────────
        // Metabolism: Energy Gain From Interactions
        // ─────────────────────────────────────────────

        // A. Attraction gives energy (symbiosis)
        float attraction = max(0.0f, force_mag);
        feeding_gain += attraction * params.energy_gain_rate * params.dt;

        // B. Eating dead particles (scavenging)
        if (type_b == 0) {
            feeding_gain += params.energy_gain_rate * 2.0f * (1.0f - dist/MAX_RADIUS) * params.dt;
        }

        // C. Eating other types (predation)
        if (type_b != type_a && dist < params.repulsion_radius * 0.7f) {
            feeding_gain += params.energy_gain_rate * 0.5f * params.dt;
        }
    }

    // ─────────────────────────────────────────────
    // Apply Forces
    // ─────────────────────────────────────────────
    vec2 accel = total_force * 40.0f;
    vec2 new_vel = (vel_a + accel * params.dt) * params.dampening;

    // ─────────────────────────────────────────────
    // Metabolism: Passive Energy Drain
    // ─────────────────────────────────────────────
    float passive_drain  = params.metabolic_rate * params.dt;
    float movement_drain = length(new_vel) * 0.002f;
    float density_drain  = max(0.0f, local_density - params.density_limit) * 0.1f;

    float total_decay = passive_drain + movement_drain + density_drain;

    float next_energy = clamp(current_energy - total_decay + feeding_gain, 0.0f, 1.0f);

    // Death
    if (next_energy <= 0.0f) {
        type_buffer.data[i] = 0;
        next_energy = 0.0f;
        new_vel *= 0.2f;
    }

    // Write-back
    out_pos_buffer.data[i] = pos_a + new_vel * params.dt;
    out_vel_buffer.data[i] = new_vel;
    energy_out_buffer.data[i] = next_energy;
}

void render_particle(uint i) {
    vec2 pos   = in_pos_buffer.data[i];
    uint type  = type_buffer.data[i];
    float energy = energy_in_buffer.data[i];

    uint flags = behavior_buffer.data[type];
    bool polar = (flags & BEHAVIOR_POLAR) != 0u;

    vec2 screen_center = params.region_size * 0.5f;
    float radius = params.radius * params.camera_zoom;
    int   range  = int(ceil(radius));
    float r      = float(range);

    vec2 center = screen_center + (pos - params.camera_origin) * params.camera_zoom;

    if (center.x + r < 0.0f || center.x - r > params.region_size.x) return;
    if (center.y + r < 0.0f || center.y - r > params.region_size.y) return;

    float angle   = polar ? angle_in_buffer.data[i] : 0.0f;
    vec2  dip_dir = polar ? vec2(cos(angle), sin(angle)) : vec2(0.0f);
    vec2  north_pt = center + dip_dir * (radius * 0.55f);

    vec2  screen_pos = center - vec2(r, r);

    for (int x = -range; x <= range; x++) {
        for (int y = -range; y <= range; y++) {
            ivec2 pixel_pos = ivec2(floor(screen_pos)) + ivec2(x, y);
            vec2  px_center = vec2(pixel_pos) + 0.5f;

            float d_main = distance(px_center, center);
            if (d_main >= radius) continue;

            vec4 col = color_buffer.data[type];

            // Dim by energy
            if (type != 0) {
                col.rgb *= clamp(energy * 0.8 + 0.2, 0.2, 1.0);
            }

            if (polar) {
                float d_north = distance(px_center, north_pt);
                if (d_north < radius * 0.38f) {
                    col = vec4(1.0f, 0.85f, 0.3f, 1.0f);
                } else {
                    vec2  to_px     = px_center - center;
                    float len_to_px = length(to_px);
                    float south_dot = (len_to_px > 0.0f) ? dot(to_px / len_to_px, -dip_dir) : 0.0f;
                    float south_blend = max(0.0f, south_dot) * 0.45f;
                    col = mix(col, vec4(0.3f, 0.5f, 1.0f, 1.0f), south_blend);
                }
            }

            imageStore(out_render_texture, pixel_pos, col);
        }
    }
}

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= params.particle_count) return;

    switch (params.step) {
        case 0: apply_physics(i);   break;
        case 1: render_particle(i); break;
    }
}
