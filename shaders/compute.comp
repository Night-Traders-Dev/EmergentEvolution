#version 450

layout(local_size_x = 256) in;

// ── Input Buffers ────────────────────────────────────────────────────────────
layout(set = 0, binding = 0, std430) buffer InPosBuffer  { vec2  data[]; } in_pos_buffer;
layout(set = 0, binding = 1, std430) buffer InVelBuffer  { vec2  data[]; } in_vel_buffer;
layout(set = 0, binding = 2, std430) readonly buffer Types  { uint  data[]; } type_buffer;
layout(set = 0, binding = 3, std430) buffer Forces       { float data[]; } force_buffer;
layout(set = 0, binding = 4, std430) buffer Colors       { vec4  data[]; } color_buffer;

// ── Output Buffers ───────────────────────────────────────────────────────────
layout(set = 0, binding = 5, std430) buffer OutPosBuffer { vec2  data[]; } out_pos_buffer;
layout(set = 0, binding = 6, std430) buffer OutVelBuffer { vec2  data[]; } out_vel_buffer;
layout(set = 0, binding = 7, rgba32f) uniform image2D out_render_texture;

// ── Behavior / Orientation Buffers ───────────────────────────────────────────
layout(set = 0, binding =  8, std430) readonly buffer Behaviors { uint  data[]; } behavior_buffer;
layout(set = 0, binding =  9, std430) buffer AngleIn            { float data[]; } angle_in_buffer;
layout(set = 0, binding = 10, std430) buffer AngVelIn           { float data[]; } avel_in_buffer;
layout(set = 0, binding = 11, std430) buffer AngleOut           { float data[]; } angle_out_buffer;
layout(set = 0, binding = 12, std430) buffer AngVelOut          { float data[]; } avel_out_buffer;

// ── Energy Buffers (ping-pong) ────────────────────────────────────────────────
layout(set = 0, binding = 13, std430) buffer EnergyIn  { float data[]; } in_energy_buffer;
layout(set = 0, binding = 14, std430) buffer EnergyOut { float data[]; } out_energy_buffer;

// ── Per-particle genome (readonly, CPU-managed) ───────────────────────────────
// Layout per particle i: [i*4+0]=photo_eff  [i*4+1]=hunt_str
//                        [i*4+2]=repro_drive [i*4+3]=social_bias
layout(set = 0, binding = 15, std430) readonly buffer Genomes { float data[]; } genome_buffer;

// ── Push Constants ────────────────────────────────────────────────────────────
layout(push_constant, std430) uniform Params {
    vec2  region_size;        // 0
    vec2  camera_origin;      // 8
    uint  particle_count;     // 16
    uint  particle_types;     // 20
    uint  step;               // 24
    float dt;                 // 28
    float camera_zoom;        // 32
    float radius;             // 36
    float dampening;          // 40
    float repulsion_radius;   // 44
    float interaction_radius; // 48
    float density_limit;      // 52
    float viscosity_strength; // 56
    float pressure_resistance;// 60
    float local_density_cap;  // 64
} params;

const uint BEHAVIOR_REPEL        = 1u;
const uint BEHAVIOR_POLAR        = 2u;
const uint BEHAVIOR_HEAVY        = 4u;
const uint BEHAVIOR_CATALYST     = 8u;
const uint BEHAVIOR_VIRAL        = 16u;

// New behaviors
const uint BEHAVIOR_ADHESIVE     = 32u;
const uint BEHAVIOR_SECRETOR     = 64u;
const uint BEHAVIOR_PHOTOSYNTH   = 128u;
const uint BEHAVIOR_PREDATOR     = 256u;
const uint BEHAVIOR_REPRODUCTIVE = 512u;

// World dimensions (toroidal)
const float WORLD_W = 2560.0f;
const float WORLD_H = 1440.0f;

float random(float v) {
    return fract(sin(dot(vec2(v, v / 10.0f), vec2(12.9898f, 78.233f))) * 43758.5453f);
}

void apply_physics(uint i) {
    const float MAX_RADIUS = params.interaction_radius;
    const float MAX_RADIUS_SQ = MAX_RADIUS * MAX_RADIUS;

    vec2  pos_a         = in_pos_buffer.data[i];
    vec2  vel_a         = in_vel_buffer.data[i];
    uint  type_a        = type_buffer.data[i];
    uint  flags_a       = behavior_buffer.data[type_a];
    
    vec2  total_force    = vec2(0.0f);
    vec2  pressure_force = vec2(0.0f);
    float local_density  = 0.0f;
    float density_factor = 1.0 - min(local_density / params.local_density_cap, 1.0);
    float energy         = in_energy_buffer.data[i];
    float interaction_energy_gain = 0.0;

    // Read this particle's genome traits
    float photo_eff   = genome_buffer.data[i * 4u + 0u]; // photosynthesis efficiency
    float hunt_str    = genome_buffer.data[i * 4u + 1u]; // predator hunt strength
    float social_bias = genome_buffer.data[i * 4u + 3u]; // same-type cohesion bias

    bool is_repel    = (flags_a & BEHAVIOR_REPEL)    != 0u;
    bool is_polar    = (flags_a & BEHAVIOR_POLAR)    != 0u;
    bool is_heavy    = (flags_a & BEHAVIOR_HEAVY)    != 0u;

    float angle_a        = is_polar ? angle_in_buffer.data[i] : 0.0f;
    vec2  dipole_a       = is_polar ? vec2(cos(angle_a), sin(angle_a)) : vec2(0.0f);
    float torque_total   = 0.0f;
    float catalyst_boost = 0.0f;

    // --- Pass 1: Local Density Calculation ---
    // Uses an exponential falloff to create a smooth 'soft body' pressure field
    for (int j = 0; j < int(params.particle_count); j++) {
        if (i == uint(j)) continue;
        vec2 delta = in_pos_buffer.data[j] - pos_a;
        // Toroidal shortest-path correction
        if (delta.x >  WORLD_W * 0.5f) delta.x -= WORLD_W;
        if (delta.x < -WORLD_W * 0.5f) delta.x += WORLD_W;
        if (delta.y >  WORLD_H * 0.5f) delta.y -= WORLD_H;
        if (delta.y < -WORLD_H * 0.5f) delta.y += WORLD_H;
        float dist_sq = dot(delta, delta);
        if (dist_sq > 0.0f && dist_sq < MAX_RADIUS_SQ) {
            float dist = sqrt(dist_sq);
            local_density += exp(-dist / (MAX_RADIUS * 0.5f));
        }
    }

    // --- Pass 2: Force Calculation ---
    for (int j = 0; j < int(params.particle_count); j++) {
        if (i == uint(j)) continue;

        vec2  pos_b   = in_pos_buffer.data[j];
        vec2  delta   = pos_b - pos_a;
        // Toroidal shortest-path correction
        if (delta.x >  WORLD_W * 0.5f) delta.x -= WORLD_W;
        if (delta.x < -WORLD_W * 0.5f) delta.x += WORLD_W;
        if (delta.y >  WORLD_H * 0.5f) delta.y -= WORLD_H;
        if (delta.y < -WORLD_H * 0.5f) delta.y += WORLD_H;
        float dist_sq = dot(delta, delta);

        if (dist_sq > 0.0f && dist_sq < MAX_RADIUS_SQ) {
            float dist   = sqrt(dist_sq);
            vec2  normal = delta / dist;
            uint  type_b = type_buffer.data[j];
            uint  flags_b = behavior_buffer.data[type_b];

            // 1. Soft-Body Pressure Force (Repulsion)
            // Keeps organisms from collapsing into a single point
            if (dist < params.repulsion_radius) {
                float overlap = 1.0f - (dist / params.repulsion_radius);
                pressure_force -= normal * overlap * params.pressure_resistance;
            }

            // 2. Attraction / Force Matrix Logic
            float attraction = force_buffer.data[type_a + type_b * params.particle_types];

            if (is_repel) attraction = -1.0f;

            if (is_polar) {
                float align_a = dot(dipole_a, normal);
                attraction *= clamp(1.0f + 1.5f * align_a, -0.5f, 2.5f);

                if ((flags_b & BEHAVIOR_POLAR) != 0u) {
                    vec2 dipole_b = vec2(cos(angle_in_buffer.data[j]), sin(angle_in_buffer.data[j]));
                    float align_b = dot(dipole_b, -normal);
                    attraction *= clamp(1.0f + 1.5f * align_b, -0.5f, 2.5f);
                    
                    float cross_ab = dipole_a.x * dipole_b.y - dipole_a.y * dipole_b.x;
                    torque_total += cross_ab * (1.0f - dist / params.interaction_radius) * 0.02f;
                }
                float to_j_cross = dipole_a.x * normal.y - dipole_a.y * normal.x;
                torque_total += to_j_cross * abs(attraction) * (1.0f - dist / params.interaction_radius) * 0.04f;
            }

            if ((flags_b & BEHAVIOR_CATALYST) != 0u) {
                catalyst_boost += 1.0f - dist / params.interaction_radius;
            }

            // --- New archetype behaviors (force-only) ---

            // ADHESIVE — strong cohesion to same type
            if ((flags_a & BEHAVIOR_ADHESIVE) != 0u && type_a == type_b) {
                attraction *= 1.8f;
            }

            // SECRETOR — chemical halo around secretor particles
            if ((flags_b & BEHAVIOR_SECRETOR) != 0u) {
                float field = exp(-dist / (params.interaction_radius * 0.4f));
                total_force += normal * field * 5.0f;
            }

            // PREDATOR — chase other types (hunt_str scales chase force and energy gain)
            if ((flags_a & BEHAVIOR_PREDATOR) != 0u && type_b != type_a) {
                float chase = 1.0f - dist / params.interaction_radius;
                total_force += normal * chase * 30.0f * hunt_str;
                // Predator gains energy proportional to its hunt strength
                if (dist < params.repulsion_radius * 2.0f)
                    interaction_energy_gain += 0.006f * hunt_str;
            }

            // Prey energy drain: use predator j's hunt strength for the drain
            if ((flags_b & BEHAVIOR_PREDATOR) != 0u && type_b != type_a
                && dist < params.repulsion_radius * 2.0f) {
                float pred_hunt = genome_buffer.data[j * 4u + 1u];
                interaction_energy_gain -= 0.006f * pred_hunt;
            }

            // Symbiotic energy gain: attraction between different types transfers energy
            if (attraction > 0.0f && type_b != type_a) {
                float proximity = 1.0f - dist / params.interaction_radius;
                interaction_energy_gain += attraction * proximity * 0.005f;
            }

            // Social bias: positive → stronger same-type cohesion, negative → repulsion
            if (type_a == type_b) {
                attraction += social_bias * 0.5f;
            }

            // Apply density limiting to attraction
            if (attraction > 0.0f) {
                float density_factor2 = 1.0f - min(max(0.0f, local_density - params.density_limit), 1.0f);
                attraction *= density_factor2;
            }

            // Final scalar attraction force
            float width    = params.interaction_radius - params.repulsion_radius;
            float midpoint = (params.repulsion_radius + params.interaction_radius) * 0.5f;
            float force_mag = attraction * (1.0f - abs(dist - midpoint) / (width * 0.5f + 0.001f));
            
            total_force += normal * force_mag * 50.0f;
        }
    }

    // PHOTOSYNTH — drift toward "light" (low-density regions)
    if ((flags_a & BEHAVIOR_PHOTOSYNTH) != 0u) {
        float light = clamp(1.0f - local_density * 0.1f, 0.0f, 1.0f);
        // Upward drift scaled by available "light"
        total_force += vec2(0.0f, 1.0f) * light * 5.0f;
        // Photosynth gains energy strongly in open areas
        interaction_energy_gain += light * 0.12f;
    }

    // --- Energy Metabolism ---
    {
        float spd   = length(vel_a);
        float delta = 0.0f;

        if (type_a == 0u) {
            // Dust: fast recovery so the birth cycle stays active
            delta += 0.15f * params.dt;
        } else {
            delta += 0.010f * params.dt;                             // ambient food gain (baseline)
            delta -= 0.015f * params.dt;                             // passive metabolic drain
            delta -= spd   * 0.00015f * params.dt;                  // movement cost (low)
            if (local_density > params.density_limit)
                delta -= (local_density - params.density_limit) * 0.005f * params.dt; // crowding
            delta += interaction_energy_gain * params.dt;
            delta += catalyst_boost * 0.008f * params.dt;           // catalyst neighbour boost
        }
        energy = clamp(energy + delta, 0.0f, 1.0f);
    }
    out_energy_buffer.data[i] = energy;

    // --- Integration with Soft-Body Physics ---

    if (is_heavy) {
        total_force    *= 0.25f;
        pressure_force *= 2.0f; // Structural nuclei are stiffer
    }

    // Combine standard forces with pressure resistance
    vec2 final_accel = total_force + pressure_force;
    vel_a += final_accel * params.dt;

    // Soft-Body Viscosity: Higher density creates more 'drag'
    float viscosity_factor = clamp(local_density * params.viscosity_strength, 0.0f, 0.9f);
    float effective_dampening = (params.dampening + catalyst_boost * 0.04f) * (1.0f - viscosity_factor);
    vel_a *= clamp(effective_dampening, 0.0f, 0.99f);

    // Speed Cap: Prevents numerical explosions in high-pressure clusters
    float max_speed = 300.0f / (1.0f + local_density * 0.15f);
    float speed = length(vel_a);
    if (speed > max_speed) vel_a = (vel_a / speed) * max_speed;

    // Movement update (Toroidal world)
    pos_a = mod(pos_a + vel_a * params.dt, vec2(WORLD_W, WORLD_H));

    out_pos_buffer.data[i] = pos_a;
    out_vel_buffer.data[i] = vel_a;

    // --- Angular update (Polar) ---
    if (is_polar) {
        float avel = avel_in_buffer.data[i];
        avel += torque_total * params.dt;
        avel *= params.dampening;
        angle_out_buffer.data[i] = mod(angle_in_buffer.data[i] + avel * params.dt, 6.28318f);
        avel_out_buffer.data[i]  = avel;
    } else {
        angle_out_buffer.data[i] = angle_in_buffer.data[i];
        avel_out_buffer.data[i]  = avel_in_buffer.data[i];
    }
}

void render_particle(uint i) {
    vec2 pos   = in_pos_buffer.data[i];
    uint type  = type_buffer.data[i];
    uint flags = behavior_buffer.data[type];
    bool polar = (flags & BEHAVIOR_POLAR) != 0u;

    vec2 screen_center = params.region_size * 0.5f;
    float radius = params.radius * params.camera_zoom;
    int   range  = int(ceil(radius));
    float r      = float(range);

    vec2 center = screen_center + (pos - params.camera_origin) * params.camera_zoom;

    if (center.x + r < 0.0f || center.x - r > params.region_size.x) return;
    if (center.y + r < 0.0f || center.y - r > params.region_size.y) return;

    float angle   = polar ? angle_in_buffer.data[i] : 0.0f;
    vec2  dip_dir = polar ? vec2(cos(angle), sin(angle)) : vec2(0.0f);
    vec2  north_pt = center + dip_dir * (radius * 0.55f);

    vec2  screen_pos = center - vec2(r, r);

    for (int x = -range; x <= range; x++) {
        for (int y = -range; y <= range; y++) {
            ivec2 pixel_pos = ivec2(floor(screen_pos)) + ivec2(x, y);
            vec2  px_center = vec2(pixel_pos) + 0.5f;

            float d_main = distance(px_center, center);
            if (d_main >= radius) continue;

            vec4 col = color_buffer.data[type];
            float energy_level = in_energy_buffer.data[i];
            col.rgb *= mix(0.12f, 1.0f, energy_level);

            if (polar) {
                float d_north = distance(px_center, north_pt);
                if (d_north < radius * 0.38f) {
                    col = vec4(1.0f, 0.85f, 0.3f, 1.0f);
                } else {
                    vec2  to_px     = px_center - center;
                    float len_to_px = length(to_px);
                    float south_dot = (len_to_px > 0.0f) ? dot(to_px / len_to_px, -dip_dir) : 0.0f;
                    float south_blend = max(0.0f, south_dot) * 0.45f;
                    col = mix(col, vec4(0.3f, 0.5f, 1.0f, 1.0f), south_blend);
                }
            }

            imageStore(out_render_texture, pixel_pos, col);
        }
    }
}

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= params.particle_count) return;

    switch (params.step) {
        case 0: apply_physics(i);   break;
        case 1: render_particle(i); break;
    }
}
